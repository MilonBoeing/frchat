$('#topic').modal('hide');});$('#topic').find('.cancelChange').click(function(){$('button[data-id=srTopicDropdown]').focus();$('.srTopicDropdown').selectpicker('val',previousTopic);$('#topic').modal('hide');elem.focus();});}
