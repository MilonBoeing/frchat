$('.warnchange').html(changing);if(changing=="Type"){var elem=document.activeElement;if(switchTypeCounter>0){$('.loadingp').remove();$('#type').modal('show');$('#type').find('.confirmChange').click(function(){changeVal=$('.srTypeDropdown').find("option:selected").val().toUpperCase();switchTypeDropdown(changeVal);$('#type').modal('hide');});$('#type').find('.cancelChange').click(function(){$('button[data-id=srTypeDropdown]').focus();$('.srTypeDropdown').selectpicker('val',previousType);$('#type').modal('hide');elem.focus();});}
