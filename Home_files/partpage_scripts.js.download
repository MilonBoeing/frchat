function waitForAdobeAnalyticsToLoadAndSendPageViewRequest(){"use strict";var pollingAttempt=0;var maxPollingAttempts=10;var pollingTimerId=setInterval(function(){try{pollingAttempt++;if(isAdobeAnalyticsLoaded()||(pollingAttempt>=maxPollingAttempts)){clearInterval(pollingTimerId);sendAdobeAnalyticsPageViewRequest();}}
catch(error){console.error("Adobe Analytics: An error occurred when sending page view reporting: "+error);}},50);}
function getPossibleCustomerCodeSelectBoxIds(){"use strict";var possibleCustomerCodeSelectBoxIds=["customerId","customerCode","customerCodes","enterOrderCustomerCode","searchShipToCustomerCode","orderCartPageCCode","quoteCartPageCCode"];return possibleCustomerCodeSelectBoxIds;}
function isCustomerCodeSelectBoxAvailable(){"use strict";var possibleCustomerCodeSelectBoxIds=getPossibleCustomerCodeSelectBoxIds();for(var i=0;i<possibleCustomerCodeSelectBoxIds.length;i++)
{var possibleCustomerCodeSelectBoxId=possibleCustomerCodeSelectBoxIds[i];var customerCodeSelectBoxSelector='select[id="'+possibleCustomerCodeSelectBoxId+'"] > option';if($(customerCodeSelectBoxSelector).length){return true;}}
return false;}
function getActiveCustomerCodeFromOnScreenSelectBox(){"use strict";if(!isCustomerCodeSelectBoxAvailable()){return null;}
var activeCustomerCode;var possibleCustomerCodeSelectBoxIds=getPossibleCustomerCodeSelectBoxIds();for(var i=0;i<possibleCustomerCodeSelectBoxIds.length;i++)
{var possibleCustomerCodeSelectBoxId=possibleCustomerCodeSelectBoxIds[i];var activeCustomerCodeSelector='select[id="'+possibleCustomerCodeSelectBoxId+'"] > option[selected]';if($(activeCustomerCodeSelector).text()){activeCustomerCode=$(activeCustomerCodeSelector).text();return activeCustomerCode;}}
return null;}
function getFirstCustomerCodeFromOnScreenSelectBox(){"use strict";if(!isCustomerCodeSelectBoxAvailable()){return null;}
var activeCustomerCode;var possibleCustomerCodeSelectBoxIds=getPossibleCustomerCodeSelectBoxIds();for(var i=0;i<possibleCustomerCodeSelectBoxIds.length;i++)
{var possibleCustomerCodeSelectBoxId=possibleCustomerCodeSelectBoxIds[i];var activeCustomerCodeSelector='select[id="'+possibleCustomerCodeSelectBoxId+'"] > option:first';if($(activeCustomerCodeSelector).text()){activeCustomerCode=$(activeCustomerCodeSelector).text();return activeCustomerCode;}}
return null;}
function extractLeadTimeFromLeadTimeNote(leadTimeNote){if(typeof leadTimeNote!=='string'){return null;}
var result=leadTimeNote.match(/\d+/);if(result!==null){return parseInt(result[0]);}
return null;};
