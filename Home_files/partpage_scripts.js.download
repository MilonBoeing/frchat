function getTabOrderByPageAndState(page,state){var tabOrder=[];switch(page){case"ModalQuoteLookup":if(state==="open"){tabOrder=TabOrderList.ModalQuoteLookup.open;$('#ModalQuoteLookup').find('#quoteNo').focus();}
break;case"ModalPOLookup":if(state==="open"){tabOrder=TabOrderList.ModalPOLookup.open;$('#ModalPOLookup').find('#poNo').focus();}
break;case"ppHome":if(state==="normal"){tabOrder=TabOrderList.ppHome.normal;}
break;case"ppReviseOrderPage":if(state==="normal"){tabOrder=TabOrderList.ppReviseOrderPage.normal;}
break;case"cancelPartialOrderModal":if(state==="normal"){tabOrder=TabOrderList.cancelPartialOrderModal.normal;}else if(state==="search"){tabOrder=TabOrderList.cancelPartialOrderModal.search;}
break;case"ppOrderCart":if(state==="normal"){tabOrder=TabOrderList.ppOrderCart.normal;$("button[data-target='#svActiveCart']").attr("tabindex",5);}
break;case"ppQuoteCart":if(state==="normal"){tabOrder=TabOrderList.ppQuoteCart.normal;}
break;case"ppEnterOrder":if(state==="normal"){tabOrder=TabOrderList.ppEnterOrder.normal;}
break;case"ppSearchSR":if(state==="normal"){tabOrder=TabOrderList.ppSearchSR.normal;}
break;case"ppSearchOrders":if(state==="open"){tabOrder=TabOrderList.ppSearchOrders.open;}else if(state==="closed"){tabOrder=TabOrderList.ppSearchOrders.closed;}
break;case"ppProcRequest":if(state==="open"){tabOrder=TabOrderList.ppProcRequest.open;}else if(state==="closed"){tabOrder=TabOrderList.ppProcRequest.closed;}
break;case"ppSearchQuotes":if(state==="open"){tabOrder=TabOrderList.ppSearchQuotes.open;}
break;default:console.log("default switch");}
return tabOrder}
