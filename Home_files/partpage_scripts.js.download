function loadAdobeAnalyticsDigitalDataInfo($productCard){try{var partSearchResult={productInfo:{},attributes:{availability:[],},};var encodedProductCodeAndSearchRank=String($productCard.data('partnumber'));var partNumber=$productCard.find('label.hidden.partNum').text();partSearchResult.productInfo={productID:partNumber,};var searchRankExtractionPattern=/^.*-(\d+)$/;var searchRankResult=encodedProductCodeAndSearchRank.match(searchRankExtractionPattern);if(searchRankResult!==null){partSearchResult.attributes.search_rank=parseInt(searchRankResult[1]);}
else{console.warn("Adobe Analytics: Unable to extract search rank from active product card header: "+encodedProductCodeAndSearchRank);}
$productCard.find('.inventory-location-data').each(function(){var locationName=$(this).find('.inventory-location-name').text();var locationCode=$(this).find('.inventory-location-name').data('location-code');if(typeof locationCode!=='undefined'&&locationCode!==null){locationCode=String(locationCode).trim();if(locationCode){var availabilityLocation={location:locationCode,};var quantityNew=parseInt($(this).find('.inventory-location-newqty').text());var quantityUsed=parseInt($(this).find('.inventory-location-usedqty').text());if(quantityNew){availabilityLocation.nw=quantityNew;}
if(quantityUsed){availabilityLocation.used=quantityUsed;}
partSearchResult.attributes.availability.push(availabilityLocation);}
else{console.warn("Adobe Analytics: An invalid warehouse location code was detected from active inventory location: "+locationName+" for "+partNumber+" : '"+locationCode+"'");}}
else{console.warn("Adobe Analytics: Unable to extract warehouse location code from active inventory location: "+locationName+" for "+partNumber);}});$productCard.find('.leadtime-note').each(function(){var leadTimeNote=$(this).text();if(leadTimeNote.match(/in stock/i)){var leadTime=extractLeadTimeFromLeadTimeNote(leadTimeNote);if(leadTime!==null){partSearchResult.attributes.lead_time1=leadTime;}}
else if(leadTimeNote.match(/out of stock/i)){var leadTime=extractLeadTimeFromLeadTimeNote(leadTimeNote);if(leadTime!==null){partSearchResult.attributes.lead_time2=leadTime;}}});$productCard.find('.pricing-container').each(function(){var priceLabel=$(this).find('.pricing-label').first().text();var priceValue=$(this).find('.pricing-value').first().text();priceValue=priceValue.replace('$','').trim();priceValue=parseFloat(priceValue);if(priceValue){if(priceLabel.match(/^List Price$/)){partSearchResult.attributes.list_price=priceValue;}
else if(priceLabel.match(/^Your Price$/)){partSearchResult.attributes.your_price=priceValue;}}});if(window.digitalData!=null){if(window.digitalData.product){window.digitalData.product.push(partSearchResult);}
else{window.digitalData.product=[partSearchResult];}}}
catch(error){console.error("Adobe Analytics: An error occurred when updating the global digitalData object with dynamically fetched part search data: "+error);}}
function loadWebSDKDataLayerInfo($productCard){try{var partSearchResult={sku:{},name:{},price:{},attributes:{availability:[],},};var encodedProductCodeAndSearchRank=String($productCard.data('partnumber'));var partNumber=$productCard.find('label.hidden.partNum').text();var partName=$productCard.find('label.hidden.partName').text();if(partNumber!==null){partSearchResult.sku=partNumber;}
if(partName!==null){partSearchResult.name=partName;}
var searchRankExtractionPattern=/^.*-(\d+)$/;var searchRankResult=encodedProductCodeAndSearchRank.match(searchRankExtractionPattern);if(searchRankResult!==null){partSearchResult.attributes.search_rank=parseInt(searchRankResult[1]);}
else{console.warn("Adobe Analytics: Unable to extract search rank from active product card header: "+encodedProductCodeAndSearchRank);}
$productCard.find('.inventory-location-data').each(function(){var locationName=$(this).find('.inventory-location-name').text();var locationCode=$(this).find('.inventory-location-name').data('location-code');if(typeof locationCode!=='undefined'&&locationCode!==null){locationCode=String(locationCode).trim();if(locationCode){var availabilityLocation={location:locationCode,};var quantityNew=parseInt($(this).find('.inventory-location-newqty').text());var quantityUsed=parseInt($(this).find('.inventory-location-usedqty').text());if(quantityNew){availabilityLocation.type="New";availabilityLocation.quantity=quantityNew;}
if(quantityUsed){availabilityLocation.type="Used";availabilityLocation.quantity=quantityUsed;}
partSearchResult.attributes.availability.push(availabilityLocation);}
else{console.warn("Adobe WebSDK: An invalid warehouse location code was detected from active inventory location: "+locationName+" for "+partNumber+" : '"+locationCode+"'");}}
else{console.warn("Adobe WebSDK: Unable to extract warehouse location code from active inventory location: "+locationName+" for "+partNumber);}});$productCard.find('.leadtime-note').each(function(){var leadTimeNote=$(this).text();if(leadTimeNote.match(/in stock/i)){var leadTime=extractLeadTimeFromLeadTimeNote(leadTimeNote);if(leadTime!==null){partSearchResult.attributes.leadTimeInStock=leadTime;}}
else if(leadTimeNote.match(/out of stock/i)){var leadTime=extractLeadTimeFromLeadTimeNote(leadTimeNote);if(leadTime!==null){partSearchResult.attributes.leadTimeOutOfStock=leadTime;}}});$productCard.find('.pricing-container').each(function(){var priceLabel=$(this).find('.pricing-label').first().text();var priceValue=$(this).find('.pricing-value').first().text();priceValue=priceValue.replace('$','').trim();priceValue=parseFloat(priceValue);if(priceValue){if(priceLabel.match(/^List Price$/)){partSearchResult.price.list_price=priceValue;}
else if(priceLabel.match(/^Your Price$/)){partSearchResult.price.your_price=priceValue;}}});if(window.adobeDataLayer!=null&&window.adobeDataLayer.length>0){if(window.adobeDataLayer[0].eventInfo.product){window.adobeDataLayer[0].eventInfo.product.push(partSearchResult);}else{window.adobeDataLayer[0].eventInfo.product=[partSearchResult];}}}
