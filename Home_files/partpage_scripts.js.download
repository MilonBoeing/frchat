else{swal('Oops...','Something went wrong!','error')}},error:function(xht,textStatus,ex){swal('Oops...','Something went wrong!','error')}});});function selectTypeTopicCodes(){var requestType=$('#supportRequestType option:selected').text();var topic=$('#supportTopic option:selected').text();var typeTopicCodes=[];var shipShortVal=($('#quantityReceived').val()!='')?shipShortVal=$('#quantityReceived').val():shipShortVal=undefined;var orderNetPrice=$('#orderNetPrice').val();var missingPaperworkVal=($('#paperworkMissing').val()!='--SELECT--')?missingPaperworkVal=$('#paperworkMissing').val():missingPaperworkVal=undefined;var paperWorkCorrectionVal=($('#paperworkReqCorrection').val()!='--SELECT--')?paperWorkCorrectionVal=$('#paperworkReqCorrection').val():paperWorkCorrectionVal=undefined;if(requestType=="Other"){topic="Other";}
if(requestType=='Order'&&topic=='SMAL'){typeTopicCodes=['L000','L010'];}
if(requestType=='Order'&&topic=='Schedule Improvement'){typeTopicCodes=['J000','J040'];}
if(requestType=='Order'&&topic=='Request AOG Escalation'){typeTopicCodes=['J000','J010'];}
if(requestType=='Order'&&topic=='Technical Assistance Needed'){typeTopicCodes=['D000','D220'];}
if(requestType=='Order'&&topic=='Additional Status Needed'){typeTopicCodes=['D000','D210'];}
if(requestType=='Order'&&topic=='Price Needed'){typeTopicCodes=['D000','D140'];}
if((requestType=='Order'||requestType=='Quote'||requestType=='Shipment'||requestType=='Other')&&topic=='Other'){typeTopicCodes=['B000','B010'];}
if(requestType=='Part'&&topic=='Technical Assistance Needed'){typeTopicCodes=['F000','F020'];}
if(requestType=='Part'&&topic=='Material Safety Data Sheet (MSDS)'){typeTopicCodes=['F000','F010'];}
if(requestType=='Quote'&&topic=='Technical Assistance Needed'){typeTopicCodes=['H000','H080'];}
if(requestType=='Quote'&&topic=='Additional Status Needed'){typeTopicCodes=['H000','H070'];}
if(requestType=='Quote'&&topic=='Extend Quote'){typeTopicCodes=['H000','H040'];}
if(requestType=='Shipment'&&topic=='Ship Short'&&orderNetPrice!=undefined){if(parseFloat(orderNetPrice)>250){typeTopicCodes=['K000','K100'];}else{typeTopicCodes=['K000','K110'];}}
if(requestType=='Shipment'&&topic=='Missing Paperwork'&&missingPaperworkVal!=undefined){if(missingPaperworkVal=='060'){typeTopicCodes=['K000','K040'];}else if(missingPaperworkVal=='090'){typeTopicCodes=['K000','K090'];}else if(missingPaperworkVal=='030'){typeTopicCodes=['K000','K020'];}else{typeTopicCodes=['K000','K040'];}}
