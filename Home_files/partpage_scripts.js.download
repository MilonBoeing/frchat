generateFields(parsedData);if(topic=="SMAL"){if($('#orderQuantity').val()!=''&&$('#orderQuantity').val()!=undefined){$('#requestedQuantity').val($('#orderQuantity').val()).prop('readonly',false);}}
$('.srFieldsForm').removeClass('hidden');$('.loading').addClass('hidden');if(type=='PART'){if($('#headerPartNumber').val()!=""){$('#partNumber').val($('#headerPartNumber').val());}}
