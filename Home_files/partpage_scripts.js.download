function populateForAllSubject(data){var subjectLine=$('#subject').data('message');var i;if(subjectLine!=undefined){for(i=0;i<data.length;i++)
{if(data[i]==null||data[i]==''){subjectLine=subjectLine.replace("{"+i+"}",'');}else{subjectLine=subjectLine.replace("{"+i+"}",data[i]);}}
$('#subject').val(subjectLine);}}
function switchTypeDropdown(type){previousType=type;switchTopicCounter=0;clearSR('type');if(type=="ORDER"||type=="QUOTE"){$('.btnLookup').removeClass('hidden');}else if(type=="OTHER"){$('.btnLookup').addClass('hidden');getTopicList(type,"NAVIGATION");switchTopicDropdown("OTHER");}else{$('.srTopicDropdownField').removeClass('hidden');getTopicList(type,"NAVIGATION");$('.btnLookup').addClass('hidden');}}
function switchTopicDropdown(topic){$('#ajaxErrorUl').html('');$('#supportRequestErrorDiv').addClass('hidden');var type=$('.srTypeDropdown').find("option:selected").val().toUpperCase();previousTopic=topic;getSrFields(type,topic);if(topic=='SCHEDULE_NEEDED'){}
$('#supportTopic').val(topic);$('.srFieldsForm').addClass('hidden');$('.srButtonsDiv').removeClass('hidden');$('.loading').removeClass('hidden');}
function selectLookupInfo(data){if(data!=undefined){var jsData={poNumber:"",itemNo:"",orderQuantity:"",orderCode:"",uom:"",entryNumber:"",partNumber:""};if(data.orderCode!=undefined){$('#orderCode').val(data.orderCode.trim());jsData.orderCode=data.orderCode.trim();}
if(data.entryNumber!=undefined){$('#entryNumber').val(data.entryNumber);jsData.entryNumber=data.entryNumber;}
if(data.poNumber!=undefined){$('#poNumber').val(data.poNumber);jsData.poNumber=data.poNumber;}
if(data.partNumber!=undefined){$('#headerPartNumber').val(data.partNumber);$('#unknownPartNo').val(data.partNumber);jsData.partNumber=data.partNumber;}
if(data.itemNo!=undefined){$('#itemNo').val(data.itemNo);jsData.itemNo=data.itemNo;}
if(data.orderNetPrice!=undefined){$('#orderNetPrice').val(data.orderNetPrice);}
if(data.orderQuantity!=undefined){$('#orderQuantity').val(data.orderQuantity);jsData.orderQuantity=data.orderQuantity;}
if(data.priority!=undefined){$('#orderPriority').val(data.priority);}
if(data.status!=undefined){$('#orderStatus').val(data.status);}
if(data.quoteExpDate!=undefined){$('#quoteOrigExpDate').val(data.quoteExpDate);}
if(data.freeOfChargeFlag!=undefined){$('#freeOfChargeFlag').val(data.freeOfChargeFlag);}
if(data.hybrisOrderType!=undefined){$('#hybrisOrderType').val(data.hybrisOrderType);}
if(data.uom!=undefined){jsData.uom=data.uom;}
if(data.requestType=="PART"){}else if(data.requestType=="ORDER"){$('.orderDataFields p.poNumberField').text(data.poNumber);$('.orderDataFields p.itemNumberField').text(data.itemNo);$('.orderDataFields p.partNumberField').text(data.partNumber);$('.orderDataFields').removeClass('hidden');$('.btnLookup').addClass('hidden');}else if(data.requestType=="QUOTE"){$('.quoteDataFields p.poNumberField').text(data.orderCode);$('.quoteDataFields p.itemNumberField').text(data.itemNo);$('.quoteDataFields p.partNumberField').text(data.partNumber);$('.quoteDataFields').removeClass('hidden');if(data.quoteOrigExpDate!=undefined){$('#quoteOrigExpDate').val(data.quoteOrigExpDate);}
$('.btnLookup').addClass('hidden');}
if(data.topic==undefined){getTopicList(data.requestType,"NAVIGATION");}
var a=window.location.href.split('/');if(a.slice(-1)[0]=='add-support-ticket#'){localStorage.setItem('pageSource',a.slice(-1)[0]);}
store.set('srDatas',{});store.set('srDatas',jsData);if(window.location.href.indexOf("supports")>-1){sessionStorage.setItem("ActiveTab"," Support");}
else{sessionStorage.setItem("ActiveTab"," Returns");}}}
function getTopicList(requestType,comingFrom){var target=ACC.config.contextPath+"/pp/en/USD/supports/getsupportrequesttopics/";var localStorageObject=store.get('srData');var price=$('#orderNetPrice').val();var priority=$('#orderPriority').val();var status=$('#orderStatus').val();var customerId=$('.custCodeSearch[name="customerId"]').val();var freeOfChargeFlag=$('#freeOfChargeFlag').val();var hybrisOrderType=$('#hybrisOrderType').val();var msds="";$('.srTopicDropdown').prop('disabled',false);if(localStorageObject!=undefined&&localStorageObject.requestType!=undefined){$(".srTypeDropdown option[value='"+localStorageObject.requestType+"']").attr("selected","selected");$(".srTypeDropdown option[value='"+localStorageObject.requestType+"']").prop("selected",true);$('.srTypeDropdown').selectpicker('refresh');}
if(comingFrom=="ORDER_SEARCH_RESULTS"||comingFrom=="PART_DETAIL_PAGE"||comingFrom=="QUOTE_SEARCH_RESULTS"||comingFrom=="QUOTE_DETAIL_PAGE"||comingFrom=="ORDER_DETAIL_PAGE"||comingFrom=="SHIPMENT_DETAIL_PAGE"){if(localStorageObject!=undefined){selectLookupInfo(localStorageObject);if(hasPrice(localStorageObject.orderNetPrice)){target+="price=true;";}
else{target+="price=false;";}
if(localStorageObject.priority!=undefined){target+="priority="+localStorageObject.priority+";";}
if(localStorageObject.requestType!=undefined){target+="requesttype="+localStorageObject.requestType+";";}
if(localStorageObject.status!=undefined){var encstatus=encodeURIComponent(localStorageObject.status);target+="status="+encstatus+";";}
if(localStorageObject.source!=undefined){target+="requestsource="+localStorageObject.source+";";}
if(localStorageObject.customerCode!=undefined){target+="customerCode="+localStorageObject.customerCode+";";}
switchTopicCounter=-1;}}
else if(comingFrom=="INFODESK"){$('.srTypeDropdown').change();}
else if(comingFrom=="NAVIGATION"){if(localStorageObject!=undefined){selectLookupInfo(localStorageObject);}
if(customerId!=undefined&&customerId!=''){target+="customerCode="+customerId+";";}
if(!msds){target+="msds="+msds+";";}
if(hasPrice(price)){target+="price=true;";}
else{target+="price=false;";}
if(priority!=undefined&&priority!=""){target+="priority="+priority+";";}
if(status!=undefined&&status!=""){target+="status="+status+";";}
if(freeOfChargeFlag!=undefined&&freeOfChargeFlag!=""){target+="freeOfChargeFlag="+freeOfChargeFlag+";";}
if(hybrisOrderType!=undefined&&hybrisOrderType!=""){target+="hybrisOrderType="+hybrisOrderType+";";}
target+="requesttype="+requestType+";requestsource=NAVIGATION";}
$.ajax({url:target,type:"GET",success:function(data){var i;var tempData;if((data.length<1)&&(requestType!="OTHER")){disableSRTopicDropdown();}
else{for(i=0;i<data.length;i++){if(data[i].value!='OTHER'){tempData+="<option value='"+DOMPurify.sanitize(data[i].value)+"'>"+DOMPurify.sanitize(data[i].display)+"</option>";}}
$('.srTopicDropdown').selectpicker("destroy");$('.srTopicDropdown').empty();$('.srTopicDropdownField').removeClass('hidden');$('.srTopicDropdown').append(tempData);$('.srTopicDropdown .dropdown-toggle').attr("tabindex","1");if(requestType=="OTHER"){$('.srTopicDropdownField').addClass('hidden');}
else{$('.srTopicDropdownField').removeClass('hidden');}
$('.srTopicDropdown').selectpicker('refresh');if(localStorageObject!=undefined&&localStorageObject.topic!=undefined){$(".srTopicDropdown option[value='"+localStorageObject.topic+"']").prop("selected",true);$('.srTopicDropdown').selectpicker('refresh');$('.srTopicDropdown').change();}
