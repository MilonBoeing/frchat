class CacheResponsesd {
    constructor(timeout = 2700000) { // default for 5 minutes
        this.data = {};
        this.timeOut = timeout;
    }

    getResponse(key) {
        if (this.isExpired(key)) {
            this.deleteCache(key);
            return false
        }
        return this.data[key];
    }

    setResponse(key, response) {
        this.data[key] = {
            response,
            timeStamp: new Date().getTime(),
        };
    }

    isExpired(key) {
        return this.data[key] ? parseInt(this.data[key].timeStamp + this.timeOut) < new Date().getTime() : false;
    }

    deleteCache(key) {
        delete this.data[key];
    }
}

const ACCOUNT_SELECTOR_CACHE = new CacheResponsesd()







class SERVER_CACHE {
    constructor() {
        // Initialization code here
        this.data = {}
    }

    getCookieValue(cookieName) {
        const cookies = document.cookie.split('; ');
        const cookieValues = [];

        cookies.forEach(cookie => {
            const [name, value] = cookie.split('=');
            if (name === cookieName) {
                cookieValues.push(value);
            }
        });

        return cookieValues.length > 0 ? cookieValues[0] : "";
    }
    setCookie({ name, value, path = "/", domain, maxAge = "31536000", expires }) {
        const cookieValue = `${name}=${value};${domain ? "domain=" + domain + ";" : ""}path=${path};${expires ? "expires=" + expires : "max-age=" + maxAge};`
        document.cookie = cookieValue;
    }
    deleteCookie(name) {
        document.cookie = name + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
    }
    storeData({ method = "DEFAULT", value = false, key, expiry_time }) {
        try {
            if (!key || !value) return
            switch (method.toLocaleUpperCase()) {
                case "LOCAL": {
                    localStorage.setItem(key, value);
                    break;
                }
                case "SESSION": {
                    sessionStorage.setItem(key, value);
                    break;
                }
                case "COOKIE": {
                    this.setCookie({ name: key, value });
                    break;
                }
                default: {
                    this.data[key] = {
                        value,
                        timeStamp: new Date().getTime(),
                    };
                }
            }
        } catch (e) { console.log({ e }); return }
    }

    getDataFromStorage({ method = "DEFAULT", key }) {
        try {
            if (!key) return
            switch (method.toLocaleUpperCase()) {
                case "LOCAL": return localStorage.getItem(key)
                case "SESSION": return sessionStorage.getItem(key);
                case "COOKIE": return this.getCookieValue(key);
                default: return this.data[key]
            }
        } catch (e) { console.log({ e }); return }
    }
    clearDataFromStorage({ method = "DEFAULT", key }) {
        try {
            if (!key) return
            switch (method.toLocaleUpperCase()) {
                case "LOCAL": return localStorage.removeItem(key)
                case "SESSION": return sessionStorage.removeItem(key);
                case "COOKIE": return this.deleteCookie(key);
                default: return this.data[key]
            }
        } catch (e) { console.log({ e }); return }
    }
}

class HTTP_SERVER extends SERVER_CACHE {
    constructor() {
        // Initialization code here
        super();
    }
    parseDataIntoUrl(data = {}) {
        try {
            const defaultObj = { lang: 'en_US', curr: 'USD' }
            const searchParams = new URLSearchParams({ ...data, ...defaultObj });
            return searchParams.toString()
        } catch (e) { }
    }
    decodeToken(token) {
        const _decodeToken = (token) => {
            try {
                return JSON.parse(atob(token));
            } catch {
                return;
            }
        }; return token
            .split('.')
            .map(token => _decodeToken(token))
            .reduce((acc, curr) => {
                if (!!curr) acc = { ...acc, ...curr };
                return acc;
            }, Object.create(null));
    }
    getBPPOCCToken() {
        try {
            const token = this.getDataFromStorage({ method: "COOKIE", key: "bppocc" })
            if (token) return token
            return false
        } catch (e) { return false }
    }
    getSessionId() {
        try {
            const bppocc = this.getBPPOCCToken()
            if (bppocc) {
                const decodedBppOcc = this.decodeToken(bppocc)
                if (decodedBppOcc["SESSION_ID"]) return decodedBppOcc["SESSION_ID"]
                return false
            }

        } catch (e) {
            return false
        }
    }
    async getAPIHeaders({ isAuthed = false, method = "GET", hasSession = false }) {
        try {
            const headers = {
                'Accept': 'application/json',
            }
            if (method === "POST") {
                headers["Content-Type"] = 'application/json'
            }
            if (isAuthed && isAuthed !== "false") {
                // const token = await oAuthTokenAPI()
                const isBPPNG = sessionStorage.getItem("boe") === "y"
                if (isBPPNG) {
                    const token = this.getBPPOCCToken()
                    if (isAuthed && token) headers["Authorization"] = `BPP-JWT${token}`
                }
            }
            if (hasSession) {
                const sessionId = this.getSessionId()
                if (sessionId) headers["bppngsessionid"] = sessionId
            }

            return new Headers(headers)
        } catch (e) { showError(e) }
    }
    // Common function to handle responses
    async fetchAPI(url, headers = {}) {
        try {
            const headers = await this.getAPIHeaders({ isAuthed: true })
            const response = await fetch(url, { headers })
            const resJSON = await response.json()
            return resJSON
        } catch (e) { console.error(e) }
    }

    async postAPI(url, body, headers = {}) {
        try {
            const method = "POST"
            const headers = await this.getAPIHeaders({ method, isAuthed: true });
            const postAPIResponse = await fetch(url, { method, headers, body })
            const res = await postAPIResponse.json()
            return res
        } catch (e) { showError(e) }
    }
}

