async function beforeLoadScriptsBPPNG() {

    //BPP classic Toggle
    // OLD_HEADER_MENU_TOGGLE = $("#header-2").find('li#menu-trigger').detach();


    // Old BPP classic search bar
    OLD_CLASSIC_BPP_SEARCH_BAR = $("#header-2").find('form#onesap_global_search').detach();

    // Navigation component
    OLD_TOP_NAV_MENU = $("#header-2").find('nav.ha-menu').detach();

    // Cart Icon change color and remove unwated Texts
    const cartIcon = await createComponent({ attributes: { class: "multi-cart-icon" }, children: [ICON_SPRITE.CART.CART_ICON] })
    OLD_MINI_CART_ICON = $("#header-2").find('a.miniCartHover').detach();
    $(OLD_MINI_CART_ICON).find(".tm-icon.zmdi.zmdi-shopping-cart").replaceWith(cartIcon)
    $(OLD_MINI_CART_ICON).contents().filter(function () {
        return this.nodeType === 3;
    }).remove()

    // let isToggleDefaultON = document.cookie.indexOf("commonHdrTgl=true") >= 0 ? true : false
    if (DSI_USER || COMMERCIAL_SPARES_USER) {

        if (COMMERCIAL_SPARES_USER) {
            OVERRIDE_SCRIPTS_INJECTION_COMPONENT_UID = "BgsAddScripts_BPPNG"
            OVERRIDE_STYLES_INJECTION_COMPONENT_UID = "BgsAddStyles_BPPNG"
            HEADER_COMPONENT_UID = "BgsHeader_BPPNG"
            TOP_NAV_COMPONENT_UID = "BgsTopNav_BPPNG"
            FOOTER_COMPONENT_UID = "BgsFooter_BPPNG"
            LOGOUT_URL = LOGOUT_URL_AVID
        } else if (DSI_USER) {
            OVERRIDE_SCRIPTS_INJECTION_COMPONENT_UID = "BgsAddScripts_DSI"
            OVERRIDE_STYLES_INJECTION_COMPONENT_UID = "BgsAddStyles_DSI"
            // GLOBAL_NAV_COMPONENT_UID = "BgsGlobalNav_DSI"
            HEADER_COMPONENT_UID = "BgsglobalHeader_DSI"
            TOP_NAV_COMPONENT_UID = "BgstopNav_DSI"
            FOOTER_COMPONENT_UID = "BgsFooter_DSI"
            LOGOUT_URL = LOGOUT_URL_B1L
        }
        const URLS_INCLUDE_ARR_MY_ACCOUNT = [
            "/history/searchQuotes",
            "/checkout/multi/summary/quote/view",
            "/history/searchReturns",
            "/return/returnpage",
            "/my-account/",
            "/price/download_catalog",
            "/procurement",
            "/searchShipTo",
            "/shipTo",
            "/cart/quote",
            "/history/"
        ]
        const URLS_INCLUDE_ARR_CART = [
            "/partpage/cart",
            "/partpage/pp/en/USD/cart",
            "cart?updatePrice=true",
        ]
        const URLS_INCLUDE_ARR_CHECKOUT = [
            "/checkout/",
        ]
        const URLS_INCLUDE_ARR_SHOP = [
            "/search/"
        ]
        if (URLS_INCLUDE_ARR_MY_ACCOUNT.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "my_account_page"
        } else if (URLS_INCLUDE_ARR_CART.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "cart_page"
            ELEMENT_VISIBILITY_STATUS["topHatBar"] = {
                ...ELEMENT_VISIBILITY_STATUS["topHatBar"],
                visibility: false,
                shouldShowGlobalNav: false,
                shouldShowAccountSelector: false,
                shouldShowSwapIcon: false,
                showShoppingAs: false,

            }
        } else if (URLS_INCLUDE_ARR_CHECKOUT.some(url => window.location.href.includes(url) && !window.location.href.includes("orderConfirmation"))) {
            PAGE_EXPERIENCE = "checkout_page"
            ELEMENT_VISIBILITY_STATUS["topHatBar"] = {
                ...ELEMENT_VISIBILITY_STATUS["topHatBar"],
                visibility: false,
                shouldShowGlobalNav: false,
                shouldShowAccountSelector: false,
                shouldShowSwapIcon: false,
                showShoppingAs: false,

            }
        }
        else if (URLS_INCLUDE_ARR_SHOP.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "shop_page"
            ELEMENT_VISIBILITY_STATUS.simplifiedFooter = false
            ELEMENT_VISIBILITY_STATUS.showNavigation = true
        } else {
            PAGE_EXPERIENCE = "other_pages"
            ELEMENT_VISIBILITY_STATUS.simplifiedFooter = false
            ELEMENT_VISIBILITY_STATUS.showNavigation = true
        }
    } else {
        OVERRIDE_SCRIPTS_INJECTION_COMPONENT_UID = "BgsAddScripts_BPPClassic"
        OVERRIDE_STYLES_INJECTION_COMPONENT_UID = "BgsAddStyles_BPPClassic"
        GLOBAL_NAV_COMPONENT_UID = "BgsGlobalNav_BPPClassic"
        HEADER_COMPONENT_UID = "BgsglobalHeader_BPPClassic"
        TOP_NAV_COMPONENT_UID = "BgstopNav_BPPClassic"
        FOOTER_COMPONENT_UID = "BgsFooter_BPPClassic"
        ELEMENT_VISIBILITY_STATUS["topHatBar"] = {
            ...ELEMENT_VISIBILITY_STATUS["topHatBar"],
            shouldShowAccountSelector: false,
            shouldShowSwapIcon: false,
            showShoppingAs: false,

        }
        ELEMENT_VISIBILITY_STATUS.showNavigation = true
        ELEMENT_VISIBILITY_STATUS.simplifiedFooter = false
    }


}
async function afterLoadScriptsBPPNG() {
    // const isToggleDefaultON = document.cookie.indexOf("commonHdrTgl=true") >= 0 ? true : false
    const searchElement = document.querySelector("header-common-search")
    const headerCartIconSlot = document.querySelector("header-cart-icon")
    const headerLoginIconSlot = document.querySelector("header-login-icon")
    const headerProfileIconSlot = document.querySelector("header-profile-icon")
    const headerBentoIconSlot = document.querySelector("header-bento-icon")
    const headerHelpIconSlot = document.querySelector("header-help-icon")
    const simplifiedHeaderButtonSlot = document.querySelector("simplified-redirect-button")
    const headerLogoElementSlot = document.querySelector("header-logo-element")
    const navigationElementDesktop = document.querySelector("desktop-nav")
    const bottomBannerSlot = document.querySelector("bottom-navigation-banner")
    if (!(COMMERCIAL_SPARES_USER || DSI_USER)) {

        // header search condition
        if (OLD_CLASSIC_BPP_SEARCH_BAR && OLD_CLASSIC_BPP_SEARCH_BAR.length > 0) {
            searchElement.setSearchBar = { type: "classic", component: OLD_CLASSIC_BPP_SEARCH_BAR }
        }

        // header cart icon
        if (OLD_MINI_CART_ICON && OLD_MINI_CART_ICON.length > 0) {
            headerCartIconSlot.setCartIcon = { type: "classic", component: OLD_MINI_CART_ICON }
        }

        // if (OLD_TOP_NAV_MENU && OLD_TOP_NAV_MENU.length > 0) {
        //     $(`#${HEADER_SLOTS.getSlot("navigation").id}`).append(OLD_TOP_NAV_MENU)
        // }
        headerLogoElementSlot.setHeaderLogoText = ""
        headerProfileIconSlot.setProfileIcon = { type: "bpp" }
        headerHelpIconSlot.setHelpIconStatus = { type: "global" }
        headerBentoIconSlot.setBentoIconStatus = { type: "global" }
        if (navigationElementDesktop) navigationElementDesktop.navStatus = { status: "show" }
    } else {
        switch (PAGE_EXPERIENCE) {
            case "cart_page": {
                simplifiedHeaderButtonSlot.setButtonStatus = { text: "Back to Shopping", url: `${API_DOMAIN_URL}${DSI_USER ? "/distribution" : "/spares"}` }
                headerLogoElementSlot.setHeaderLogoText = SITE_LOGO_TEXTS[PAGE_EXPERIENCE]
                headerProfileIconSlot.setProfileIcon = { type: "global" }
                break;
            }
            case "checkout_page": {
                simplifiedHeaderButtonSlot.setButtonStatus = { text: "Back to Cart", url: `/partpage/cart` }
                headerLogoElementSlot.setHeaderLogoText = SITE_LOGO_TEXTS[PAGE_EXPERIENCE]
                headerProfileIconSlot.setProfileIcon = { type: "global" }
                break;
            }
            case "shop_page": {
                searchElement.setSearchBar = { type: "global" }
                headerCartIconSlot.setCartIcon = { type: "mini" }
                headerProfileIconSlot.setProfileIcon = { type: "global" }
                if (navigationElementDesktop) navigationElementDesktop.navStatus = { status: "show" }
                headerHelpIconSlot.setHelpIconStatus = { type: "global" }
                headerBentoIconSlot.setBentoIconStatus = { type: "global" }
                headerLogoElementSlot.setHeaderLogoText = SITE_LOGO_TEXTS[PAGE_EXPERIENCE]
                break;
            }
            case "my_account_page": {
                searchElement.setSearchBar = { type: "global" }
                headerCartIconSlot.setCartIcon = { type: "mini" }
                headerProfileIconSlot.setProfileIcon = { type: "global" }
                headerHelpIconSlot.setHelpIconStatus = { type: "global" }
                headerBentoIconSlot.setBentoIconStatus = { type: "global" }
                headerLogoElementSlot.setHeaderLogoText = SITE_LOGO_TEXTS[PAGE_EXPERIENCE]
                break;
            }
            case "other_pages":
            default: {
                searchElement.setSearchBar = { type: "global" }
                headerCartIconSlot.setCartIcon = { type: "mini" }
                headerProfileIconSlot.setProfileIcon = { type: "global" }
                headerHelpIconSlot.setHelpIconStatus = { type: "global" }
                headerBentoIconSlot.setBentoIconStatus = { type: "global" }
                if (navigationElementDesktop) navigationElementDesktop.navStatus = { status: "show" }
                headerLogoElementSlot.setHeaderLogoText = SITE_LOGO_TEXTS[PAGE_EXPERIENCE]
            }
        }
    }

    if (!DSI_USER && !COMMERCIAL_SPARES_USER) {
        await waitForElement(".profile_dropdown_list")
        const currentUserName = document.querySelector(".profile-name").innerText
        const UserObj = { name: currentUserName.split(/\u00A0|\s+/).filter(Boolean)[0] }
        const profileIcon = document.querySelector("header-profile-icon")
        if (profileIcon) profileIcon.setProfileIconName = UserObj
    }

    function adjustHashAnchors() {
        let hatags = document.getElementsByTagName("a");
        for (let i = 0; i < hatags.length; i++) {
            let currElem = document.getElementsByTagName("a")[i];
            if (currElem && currElem.href.endsWith("#")) currElem.href = "javascript:void(0);";
        }
    }
    setTimeout(adjustHashAnchors, 50)
}
async function replaceOldContents() {
    const headerWrapperComponent = await createComponent(HEADER_WRAPPER_COMPONENT_WRAPPER_SLOTS)
    $(`#${HEADER_REPLACE_ID}`).replaceWith(headerWrapperComponent)

    const footerWrapperComponentObj = {
        attributes: footerWrapperDIV
    }
    const footerWrapperComponent = await createComponent(footerWrapperComponentObj)
    $(`#${FOOTER_REPLACE_ID}`).replaceWith(footerWrapperComponent)
    return true
}
