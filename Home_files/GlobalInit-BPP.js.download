class HEADER_CONTROLLER extends HTTP_SERVER {
    constructor() {
        super(); // Call the parent class constructor
        this.data = false
        this.cartData = false
        this.headerToolsData = {}
    }

    async fetchDetailsFromAPI(url, isAuthed = false, hasSession = false) {
        try {
            const headers = await getAPIHeaders({ isAuthed, hasSession })
            const componentAPIResponse = await this.fetchAPI(url, headers)
            return componentAPIResponse
        } catch (e) { showError(e) }
    }
    async getAllComponentsData(components = '') {
        if (components) {
            let len = components.split(' ').length;
            let PARAMS = `${API_URL_PARAMETERS}&currentPage=0&pageSize=${len}&componentIds=${components.replaceAll(' ', '%2C')}`;
            try {
                const url = `${API_DOMAIN_URL}/${COMPONENT_API_PATH}?${PARAMS}`
                const componentData = await this.fetchDetailsFromAPI(url)
                return componentData
            } catch (e) { showError(e) }
        }
    }

    async fetchComponentFromUid(COMPONENT_ID) {
        try {
            if (COMPONENT_ID && typeof COMPONENT_ID === "string") {
                const url = `${API_DOMAIN_URL}/${COMPONENT_API_PATH}/${COMPONENT_ID}?${API_URL_PARAMETERS}`
                const componentData = await this.fetchDetailsFromAPI(url)
                return componentData
            }
        } catch (e) { showError(e) }
    }
    async fetchMultipleComponentsFromUid(COMPONENTS_IDS) {
        try {
            if (COMPONENTS_IDS && typeof COMPONENTS_IDS === "string") {
                const componentPromise = await Promise.all(COMPONENTS_IDS.split(" ").map(comp_uid => this.fetchComponentFromUid(comp_uid)))
                return componentPromise
            }
        } catch (e) { showError(e) }
    }
    async getCompleteDataFromAPI(data) {
        const childrenList = data?.bgsNavigationLinksCollection || data?.cmsLinksList || data?.navEntries || data?.bgsAccountNavigationLinksCollection

        let modifiedData = data
        if (childrenList) {
            const navListArray1 = await this.fetchMultipleComponentsFromUid(childrenList)
            const navListArray = await Promise.all(navListArray1.map(async (dat) => await this.getCompleteDataFromAPI(dat)))
            modifiedData = { ...data, navListArray }
        }
        return modifiedData
    }
    // Method to fetch response using the inherited fetchResponse method
    async fetchUniqueHeaderCompleteData(url) {
        const res = await this.fetchAPI(url)
        const arr = await this.getAllComponentsData(res?.slotList).then(res => res.component)
        const arrRes = await Promise.all(arr.map(item => this.getCompleteDataFromAPI(item)))
        const finalObj = structuredClone(res)
        finalObj["headerToolsData"] = arrRes
        return finalObj
    }

    async fetchData() {
        const url = `${API_DOMAIN_URL}/${COMPONENT_API_PATH}/${HEADER_COMPONENT_UID}?${API_URL_PARAMETERS}`
        const res = await this.fetchUniqueHeaderCompleteData(url);
        this.data = res
    }
    async getData() {
        return this.data
    }
    getheaderToolsData() {
        return this.data.headerToolsData
    }
    async getCartData({ body, refresh = false }) {
        if (!this.cartData || refresh) {
            const payload = JSON.stringify(body)
            const res = await this.postAPI(`${MINI_CART_MERGER_API_URL}?reload=true&${API_URL_PARAMETERS}`, payload)
            this.cartData = res
            return this.cartData
        } else {
            return this.cartData
        }
    }
    async deleteCartItems({ body }) {
        const payload = JSON.stringify(body);
        const res = await this.postAPI(`${MINI_CART_DELETE_API_URL}`, payload);
        return res;
    }
}

class SEARCH_CONTROLLER extends HTTP_SERVER {
    constructor() {
        super(); // Call the parent class constructor
        this.suggestions_data = false
        this.related_contents_data = false
        this.products_search_data = false
        this.recent_search_data = false
    }


    getRecentSearchFromStorage() {
        try {
            const recentSearchList = this.getDataFromStorage({ method: "LOCAL", key: `bgs_hrs_boeing` })
            if (Array.isArray(recentSearchList) && recentSearchList.length >= 0) return recentSearchList
            if (recentSearchList && typeof recentSearchList === "string") {
                const parsedList = JSON.parse(recentSearchList)
                if (typeof parsedList === "object" && Array.isArray(parsedList) && parsedList.length >= 0) return parsedList
            }
            return false
        } catch (e) { return false }
    }
    clearRecentSearchFromStorage(clear_method = "ALL", key) {
        if (clear_method === "SINGLE") {
            const recentSearchList = this.getRecentSearchFromStorage() || [];
            const newList = recentSearchList.filter(({ text }) => text !== key)
            this.storeData({ method: "LOCAL", key: "bgs_hrs_boeing", value: JSON.stringify(newList) });
        } else {
            this.storeData({ method: "LOCAL", key: "bgs_hrs_boeing", value: JSON.stringify([]) });
        }
        return
    }
    saveRecentSearchtoStorage(searchQuery) {
        const recentSearchList = this.getRecentSearchFromStorage() || [];
        let newList = []
        if (recentSearchList.some(obj => obj.text === searchQuery)) {
            newList = recentSearchList.map(obj => {
                if (obj.text === searchQuery) {
                    obj.count += 1
                }
                return obj
            })
        } else {
            newList = structuredClone(recentSearchList)
            newList.push({ text: searchQuery, count: 1 })
        }
        this.storeData({ method: "LOCAL", key: "bgs_hrs_boeing", value: JSON.stringify(newList) });
    }

    async getSuggestions(body = {}) {
        const contentBody = this.parseDataIntoUrl(body)
        const API_URL = `${SEARCH_SUGGESTIONS_API}${contentBody ? "?" + contentBody : ""}`
        const cachedData = this.getDataFromStorage({ key: API_URL })
        if (cachedData) {
            return cachedData.value
        } else {
            const value = await this.fetchAPI(API_URL)
            this.storeData({ key: API_URL, value })
            return value
        }
    }
    async getProducts(body = {}) {
        const contentBody = this.parseDataIntoUrl(body)
        const API_URL = `${SEARCH_PRODUCTS_API}${contentBody ? "?" + contentBody : ""}`
        const cachedData = this.getDataFromStorage({ key: API_URL })
        if (cachedData) {
            return cachedData.value
        } else {
            const value = await this.fetchAPI(API_URL)
            this.storeData({ key: API_URL, value })
            return value
        }
    }
    async getRelatedContents(body = {}) {
        const contentBody = this.parseDataIntoUrl(body)
        const API_URL = `${SEARCH_RELATED_CONTENTS_API}${contentBody ? "?" + contentBody : ""}`
        const cachedData = this.getDataFromStorage({ key: API_URL })
        if (cachedData) {
            return cachedData.value
        } else {
            const value = await this.fetchAPI(API_URL)
            this.storeData({ key: API_URL, value })
            return value
        }
    }
}

class TOP_NAVIGATION_CONTROLLER extends HTTP_SERVER {
    constructor() {
        super(); // Call the parent class constructor
        this.data = false
    }

    createObj({ linkName = "", url = "/", external = "false" }) {
        return {
            "linkUrl": {
                "external": external,
                "name": linkName,
                linkName,
                url,
            },
            "menuType": "PRODUCT",
            "navListArray": [],
            "name": linkName,
        }
    }
    pushArr(arr = [], ind, value) {

        if (ind >= arr.length) {
            // If index is greater than or equal to array length, push at the end
            arr.push(value);
        } else {
            // Otherwise, insert at the index by shifting elements to the right
            arr.splice(ind, 0, value);
        }
        return arr
    }
    parseTopNavigationData(data) {
        if (sessionStorage.getItem("boe") === 'y')
            return data

        let showTransferLink = false;
        let showCustomerLink = false;
        let showExpressOrderLink = false;
        let showBulkOrderLink = false;
        let newArr = []
        const that = this

        $(OLD_TOP_NAV_MENU).find("> ul > li").each(function (index, item) {
            const oldLinkName = item.children[0]?.textContent?.trim() ?? "";
            if (oldLinkName === "Customers") { showCustomerLink = that.createObj({ linkName: "Customers", url: "/partpage/pp/en/USD/customercodes/search", external: "false" }); }
            if (oldLinkName === "Transfers") { showTransferLink = that.createObj({ linkName: "Transfers", url: "/partpage/pp/en/USD/transfers/searchTransfers", external: "false" }); }
            if (oldLinkName === "Orders" && item.innerHTML.includes("Express Orders")) { showExpressOrderLink = that.createObj({ linkName: "Express Orders", url: "/partpage/pp/en/USD/quick/orders", external: "false" }); }
            if (oldLinkName === "Orders" && item.innerHTML.includes("Bulk Order")) { showBulkOrderLink = that.createObj({ linkName: "Bulk Order", url: "/partpage/pp/en/USD/bulk/orders", external: "false" }); }
        })

        if (Array.isArray(data.navListArray)) {
            newArr = structuredClone(data.navListArray)

        } else if (typeof data.navListArray === "object") {
            newArr = [structuredClone(data.navListArray)]
        }

        if (showTransferLink) newArr = this.pushArr(newArr, 2, showTransferLink)
        if (showCustomerLink) newArr = this.pushArr(newArr, -2, showCustomerLink)
        if (showExpressOrderLink) {
            newArr = newArr.map(item => {
                if (item.name === "Orders") {
                    item.navListArray.push(showExpressOrderLink)
                    return item
                }
                return item
            })
        }
        if (showBulkOrderLink) {
            newArr = newArr.map(item => {
                if (item.name === "Orders") {
                    item.navListArray.push(showBulkOrderLink)
                    return item
                }
                return item
            })
        }
        data.navListArray = newArr
        return data
    }

    // Method to fetch response using the inherited fetchResponse method
    async fetchData() {
        const url = `${API_DOMAIN_URL}/bgswebservices/v2/boeing/cms/categorynav/component/${TOP_NAV_COMPONENT_UID}?${API_URL_PARAMETERS}`
        const res = await this.fetchAPI(url);
        try {
            if (res.errors) {
                this.data = false
            }
            else {
                const parsedData = this.parseTopNavigationData(res)
                console.log({ parsedData })
                this.data = parsedData
            }

        } catch (e) {
            console.log(e)
            this.data = false
        }
    }
    async getData() {
        return this.data
    }
}

