/*********** HTTP Methods START ***********/
function getCookieValue(cookieName) {
    const cookies = document.cookie.split('; ');
    const cookieValues = [];

    cookies.forEach(cookie => {
        const [name, value] = cookie.split('=');
        if (name === cookieName) {
            cookieValues.push(value);
        }
    });

    return cookieValues.length > 0 ? cookieValues[0] : "";
}
function setCookie({ name, value, path = "/", domain, maxAge = "31536000", expires }) {
    const cookieValue = `${name}=${value};${domain ? "domain=" + domain + ";" : ""}path=${path};${expires ? "expires=" + expires : "max-age=" + maxAge};`
    document.cookie = cookieValue;
}
async function setTbCookieVal(newVal) {

    setCookie({ name: 'commonHdrTgl', value: newVal, maxAge: "session" })
    if (window.location.href.includes(".boeing.com")) {
        setCookie({ name: 'bppTGLExp', value: newVal, domain: "boeing.com", maxAge: "session" })
    }

    return true
}
async function getUrlTransferParameters(url = "") {
    try {
        if (url) {
            // const token = await transferTokenPostAPI()
            const current_domain = window.location.origin
            const updatedUrl = new URL(url)
            // updatedUrl.searchParams.set("tt", token)
            updatedUrl.searchParams.set("parentId", current_domain)
            updatedUrl.searchParams.set("refApp", btoa("Auth"))
            // if (token && token !== undefined && typeof token === "string")
            return (updatedUrl.href)
        }
        return false

    } catch (e) { console.log("generating the transfer Token for url failed") }

}
function decodeToken(token) {
    const _decodeToken = (token) => {
        try {
            return JSON.parse(atob(token));
        } catch {
            return;
        }
    }; return token
        .split('.')
        .map(token => _decodeToken(token))
        .reduce((acc, curr) => {
            if (!!curr) acc = { ...acc, ...curr };
            return acc;
        }, Object.create(null));
}
function getSessionId() {
    try {
        const bppocc = getJWTToken()
        if (bppocc) {
            const decodedBppOcc = decodeToken(bppocc)
            if (decodedBppOcc["SESSION_ID"]) return decodedBppOcc["SESSION_ID"]
            return false
        }

    } catch (e) {
        return false
    }
}
function getJWTToken() {
    // let token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJBVklBVElPTl9JRCI6InQzNDg2NjExIiwiaXNzIjoiQm9laW5nIiwiZXhwIjoxNzE1MzI2MTc4fQ.5tkDR-CX44CL6_mUZ19EwJN9S4NC2VF_rQfGpKpPzvI"
    let token = "";
    try {
        const cookies = document.cookie.split(';')
        const bppoccValue = cookies.find(cookie => cookie.includes('bppocc'))
        if (bppoccValue) {
            token = bppoccValue?.split('=')[1]
        }
        if (token)
            return token
        return false
    } catch (e) { showError(e) }
}
async function transferTokenPostAPI() {
    try {
        const token = getJWTToken()
        const headers = await getAPIHeaders({ isAuthed: false, method: "POST" })
        const body = JSON.stringify({ token })
        const transferTokenPromise = await postAPI(CREATE_TRANSFER_TOKEN_API_URL, body, headers)
        if (transferTokenPromise.ok) {
            const transferToken = await transferTokenPromise.text()
            return transferToken
        } else {
            console.log("Something went wrong try again later : ", { transferTokenPromise })
        }
    } catch (e) { showError(e) }
}
