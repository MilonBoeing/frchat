    //             window.location.href = bppngexperienceurlObj.href
    //         } else {
    //             sessionStorage.setItem("one_tab_experience", "false")
    //             // No Auto redirection
    //         }
    //     }
    // } catch (e) {
    //     console.error("Login auto redirect failed")
    //     currentSiteUrlObj.searchParams.delete("bppngexperienceurl")
    //     history.pushState(null, "", currentSiteUrlObj.href);
    // }


    // Logout redirection on logout button click
    try {
        const logoutUrl = currentSiteUrlObj.searchParams.get("logoutUrl")
        const logoutUrlObj = new URL(logoutUrl)
        if ((logoutUrlObj.protocol === "https:" || logoutUrlObj.protocol === "http:") && logoutUrlObj.href?.length > 0) {
            sessionStorage.clear();
            localStorage.clear();
            document.cookie.split(';').forEach(function (c) {
                document.cookie = c.trim().split('=')[0] + '=;' + 'expires=Thu, 01 Jan 1970 00:00:00 UTC;';
            });
            window.location.href = logoutUrlObj.href
            COMMERCIAL_SPARES_USER = false
        }

    } catch (e) { }


    // Enable Togglebar if the url parameter "enableBppNg" is present 
    try {
        const enableBppNg = currentSiteUrlObj.searchParams.get("enableBppNg")
        if (isToggleDefaultON && (enableBppNg === true || enableBppNg === "true")) {
            sessionStorage.setItem("boe", "y")
            currentSiteUrlObj.searchParams.delete("enableBppNg")
            history.pushState(null, "", currentSiteUrlObj.href);
            isToggleDefaultON = false
            COMMERCIAL_SPARES_USER = true
        }
