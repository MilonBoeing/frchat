async function beforeInjectScripts() {

    let isToggleDefaultON = sessionStorage.getItem("boe") === "y"

    const urlsToWatch = [
        // the urls where we should not redirect to
        "/price/download_catalog",
        "/procurement/request",
        "/history/searchOrders",
        "/cart",
        "/cart/quote",
        "/history/searchQuotes",
        "/checkout/multi/summary/quote/view",
        "/history/searchReturns",
        "/return/returnpage",
        "/search",
        "/searchShipTo/search",
        "/shipTo/addShipTo",
        "/supports/search-support-tickets",
        "/supports/add-support-ticket",
        "/infoDesk",
        "/customercodes/search",
        "/logout",
        "/my-account/update-profile",
        "/checkout/multi/summary/view",
        "/accessDenied",
        "/checkout/multi/summary/updateOrderType",
        "/checkout/orderConfirmation",
        "/partpage",
    ]

    const currentSiteUrlObj = new URL(window.location.href)


    // Disable Toggle bar and return to classic state
    try {
        const disableBppNg = currentSiteUrlObj.searchParams.get("disableBppNg")
        if (disableBppNg === true || disableBppNg === "true") {
            sessionStorage.setItem("boe", "n")
            currentSiteUrlObj.searchParams.delete("disableBppNg")
            history.pushState(null, "", currentSiteUrlObj.href);
            isToggleDefaultON = false
            COMMERCIAL_SPARES_USER = false
        }
    } catch (e) { }


    // Enable the NG experience if the url has a param
    try {
        const isNg = currentSiteUrlObj.searchParams.get("boe")
        if (atob(isNg).toLocaleLowerCase() === "y") {
            sessionStorage.setItem("boe", "y")
            currentSiteUrlObj.searchParams.delete("boe")
            history.pushState(null, "", currentSiteUrlObj.href);
            isToggleDefaultON = true
            COMMERCIAL_SPARES_USER = true;
            DSI_USER = false
            window.bgsExp = "bppng"
        }
    } catch (e) { }

    try {
        currentSiteUrlObj.searchParams.delete("refApp");
        history.pushState(null, "", currentSiteUrlObj.href);
    } catch (e) { }
    // Enable toggle and return to the url as per param value bppngexperience
    // try {
    //     const bppngexperienceurl = currentSiteUrlObj.searchParams.get("bppngexperience")
    //     const bppngexperienceurlObj = new URL(bppngexperienceurl)
