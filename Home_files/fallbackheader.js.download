async function BGSHelpIconComponent(component_id, iconData) {
    if (!FALLBACK_DATA[DATA_ENV].HELP_ICON_DATA || !(FALLBACK_DATA[DATA_ENV].HELP_ICON_DATA?.bgsNavigationLinksCollection)) {
        return {};
    } else {
        updateIconAvailablity("help_icon_list");
    }

    return {
        attributes: { class: 'help_icon_component' },
        children: [
            {
                tagName: 'button',
                attributes: { class: 'help_toggle_button', type: 'button', title: "Help" },
                eventListeners: {
                    click: function () {
                        hideIcons();
                        $(".help_icon_list").show();
                        $(".help_back_drop").show();
                        $(".help_icon_slot").addClass("active");
                    }
                },
                children: [
                    ICON_SPRITE.HELP_ICON,
                    {
                        attributes: { class: 'help_icon_list' },
                        children: [{
                            tagName: 'ul',
                            attributes: { class: "bento_list_wrapper" },
                            children: (FALLBACK_DATA[DATA_ENV].HELP_ICON_DATA?.navListArray || [])?.map((header_item) => {
                                return {
                                    tagName: 'li',
                                    attributes: { class: "bento_item_header_component" },
                                    children: [{
                                        tagName: 'p',
                                        attributes: { class: "bento_icon_header_title", text: header_item?.headerText },
                                    }, {
                                        tagName: 'ul',
                                        attributes: { class: "bento_items_links_list" },
                                        children: (header_item?.navListArray || []).map((linkData) => {
                                            const { isExternal, linkText, linkUrl } = linkData
                                            const target = ((isExternal === true || isExternal === "true") ? "_blank" : "")
                                            return {
                                                tagName: 'li',
                                                children: [
                                                    {
                                                        tagName: 'a',
                                                        eventListeners: {
                                                            click: function () {
                                                                $(".help_icon_list").hide();
                                                                $(".help_back_drop").hide();
                                                            }
                                                        },
                                                        children: (isExternal === true || isExternal === "true") ? [
                                                            {
                                                                tagName: "i",
                                                                attributes: {
                                                                    class: "material-icons",
                                                                    text: "open_in_new"
                                                                }
                                                            }
                                                        ] : [],
                                                        attributes: { text: linkText, href: linkUrl, target }
                                                    }
                                                ]
                                            }
                                        })
                                    }
                                    ]
                                }
                            })
                        }]
                    }]
            },
            {
                attributes: { class: "help_back_drop" },
                eventListeners: {
                    click: function () {
                        $(".help_icon_list").hide();
                        $(".help_back_drop").hide();
                    }
                },
            }
        ]
    }
}
class BoeingHelpIconComponent extends HTMLElement {
    constructor() {
        super()
