            /* Chrome , safari */
            display: none;
        }
        }
        #global_nav_wrapper .global-nav-items.animate {
        animation: swipe-animation 1.5s linear;
        animation-delay: 1s;
        }
        #global_nav_wrapper .global-nav-items .global-nav-item {
