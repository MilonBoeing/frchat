let OLD_CLASSIC_BPP_SEARCH_BAR;
// let OLD_HEADER_MENU_TOGGLE;
let OLD_TOP_NAV_MENU;
let OLD_MINI_CART_ICON;
let PAGE_EXPERIENCE = "other_pages"
const SITE_LOGO_TEXTS = {
    "my_account_page": "My Account",
    "cart_page": "Shop",
    "checkout_page": "Shop",
    "shop_page": "Shop"
}

let DSI_USER = false
let COMMERCIAL_SPARES_USER = false
let CLASSIC_USER = true

async function beforeInjectScripts() {
    try {
        let [currentSiteUrl, queryParams] = window.location.href.split("?")
        const urlParams = new URLSearchParams(queryParams)
        const bgs_exp_cookie = urlParams.get("refApp") || urlParams.get("ref")
        switch (bgs_exp_cookie.toLocaleLowerCase()) {
            case "dsi": {
                setCookie({ name: 'bgs_ecomm_exp', value: "DSI" })
                break;
            }
            case "bppng": {
                setCookie({ name: 'bgs_ecomm_exp', value: "BPPNG" })
                break;
            }
            case "myaccount": {
                setCookie({ name: 'bgs_ecomm_exp', value: "BPPNG" })
                break;
            }
            default: {
                setCookie({ name: 'bgs_ecomm_exp', value: "CLASSIC" })
                break;
            }
        }

    } catch (e) {

    }
}
async function beforeLoadScriptsBPPNG() {

    //BPP classic Toggle
    // OLD_HEADER_MENU_TOGGLE = $("#header-2").find('li#menu-trigger').detach();


    // Old BPP classic search bar
    OLD_CLASSIC_BPP_SEARCH_BAR = $("#header-2").find('form#onesap_global_search').detach();

    // Navigation component
    OLD_TOP_NAV_MENU = $("#header-2").find('nav.ha-menu').detach();

    // Cart Icon change color and remove unwated Texts
    const cartIcon = await createComponent({ tagName: "i", attributes: { class: "material-icons-outlined multi-cart-icon", text: "shopping_cart" } })
    OLD_MINI_CART_ICON = $("#header-2").find('a.miniCartHover').detach();
    $(OLD_MINI_CART_ICON).find(".tm-icon.zmdi.zmdi-shopping-cart").replaceWith(cartIcon)
    $(OLD_MINI_CART_ICON).contents().filter(function () {
        return this.nodeType === 3;
    }).remove()

    if (DSI_USER || COMMERCIAL_SPARES_USER) {

        if (DSI_USER) {
            GLOBAL_NAV_COMPONENT_UID = "BgsGlobalNav_DSI"
            HEADER_COMPONENT_UID = "BgsglobalHeader_DSI"
            TOP_NAV_COMPONENT_UID = "BgstopNav_DSI"
            FOOTER_COMPONENT_UID = "BgsFooter_DSI"
        }
        const URLS_INCLUDE_ARR_MY_ACCOUNT = [
            "/history/searchQuotes",
            "/checkout/multi/summary/quote/view",
            "/history/searchReturns",
            "/return/returnpage",
            "/my-account/",
            "/price/download_catalog",
            "/procurement",
            "/searchShipTo",
            "/shipTo",
            "/cart/quote",
            "/history/"
        ]
        const URLS_INCLUDE_ARR_CART = [
            "/partpage/cart",
            "/partpage/pp/en/USD/cart",
            "cart?updatePrice=true",
        ]
        const URLS_INCLUDE_ARR_CHECKOUT = [
            "/checkout/",
        ]
        const URLS_INCLUDE_ARR_SHOP = [
            "/search/"
        ]
        if (URLS_INCLUDE_ARR_MY_ACCOUNT.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "my_account_page"
            // HEADER_COMPONENT_UID = "BgsglobalHeader_MyAccount"
            // TOP_NAV_COMPONENT_UID = "BgstopNav_MyAccount"
            // FOOTER_COMPONENT_UID = "BgsFooter_MyAccount"
            ELEMENT_VISIBILITY_STATUS.simplifiedFooter = true

        } else if (URLS_INCLUDE_ARR_CART.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "cart_page"
            ELEMENT_VISIBILITY_STATUS.simplifiedFooter = true
        } else if (URLS_INCLUDE_ARR_CHECKOUT.some(url => window.location.href.includes(url) && !window.location.href.includes("orderConfirmation"))) {
            PAGE_EXPERIENCE = "checkout_page"
            ELEMENT_VISIBILITY_STATUS.simplifiedFooter = true
        }
        else if (URLS_INCLUDE_ARR_SHOP.some(url => window.location.href.includes(url))) {
            PAGE_EXPERIENCE = "shop_page"
            ELEMENT_VISIBILITY_STATUS.showTopHatBar = true
            ELEMENT_VISIBILITY_STATUS.showAccountSelector = true
        } else {
            ELEMENT_VISIBILITY_STATUS.showTopHatBar = true
            ELEMENT_VISIBILITY_STATUS.showAccountSelector = true
        }
    } else {
        GLOBAL_NAV_COMPONENT_UID = "BgsGlobalNav_BPPClassic"
        HEADER_COMPONENT_UID = "BgsglobalHeader_BPPClassic"
        TOP_NAV_COMPONENT_UID = "BgstopNav_BPPClassic"
        FOOTER_COMPONENT_UID = "BgsFooter_BPPClassic"
        ELEMENT_VISIBILITY_STATUS.showTopHatBar.showShoppingAs = false
        ELEMENT_VISIBILITY_STATUS.showNavigation = true
        ELEMENT_VISIBILITY_STATUS.simplifiedFooter = false
    }
}
async function afterLoadScriptsBPPNG() {
    const searchElement = document.querySelector("header-common-search")
    const headerCartIconSlot = document.querySelector("header-cart-icon")
    const headerLoginIconSlot = document.querySelector("header-login-icon")
    const headerProfileIconSlot = document.querySelector("header-profile-icon")
    const headerBentoIconSlot = document.querySelector("header-bento-icon")
    const headerHelpIconSlot = document.querySelector("header-help-icon")
    const simplifiedHeaderButtonSlot = document.querySelector("simplified-redirect-button")
    const headerLogoElementSlot = document.querySelector("header-logo-element")
    const navigationElementDesktop = document.querySelector("desktop-nav")

    if (CLASSIC_USER) {

        // header search condition
        if (OLD_CLASSIC_BPP_SEARCH_BAR && OLD_CLASSIC_BPP_SEARCH_BAR.length > 0) {
            searchElement.setSearchBar = { type: "classic", component: OLD_CLASSIC_BPP_SEARCH_BAR }
        }

        // header cart icon
        if (OLD_MINI_CART_ICON && OLD_MINI_CART_ICON.length > 0) {
            headerCartIconSlot.setCartIcon = { type: "classic", component: OLD_MINI_CART_ICON }
        }

        // if (OLD_TOP_NAV_MENU && OLD_TOP_NAV_MENU.length > 0) {
        //     $(`#${HEADER_SLOTS.getSlot("navigation").id}`).append(OLD_TOP_NAV_MENU)
        // }
        headerProfileIconSlot.setProfileIcon = { type: "bpp" }
        headerHelpIconSlot.setHelpIconStatus = { type: "global" }
        headerBentoIconSlot.setBentoIconStatus = { type: "global" }
        if (navigationElementDesktop) navigationElementDesktop.navStatus = { status: "show" }
    }


    function adjustHashAnchors() {
        let hatags = document.getElementsByTagName("a");
        for (let i = 0; i < hatags.length; i++) {
            let currElem = document.getElementsByTagName("a")[i];
            if (currElem && currElem.href.endsWith("#")) currElem.href = "javascript:void(0);";
        }
    }
    setTimeout(adjustHashAnchors, 50)
}

async function replaceHeader() {

    const headerWrapperComponent = await createComponent(HEADER_WRAPPER_COMPONENT_WRAPPER_SLOTS)
    $(`#${HEADER_REPLACE_ID}`).replaceWith(headerWrapperComponent)

    await Promise.all([
        createShoppingAsBar(),
        createHeader(),
        createTopNav(),
    ])
}

async function replaceMainContent() {
    return true
}
async function replaceFooter() {
    const footerWrapperComponentObj = {
        attributes: footerWrapperDIV
    }
    const footerWrapperComponent = await createComponent(footerWrapperComponentObj)
    $(`#${FOOTER_REPLACE_ID}`).replaceWith(footerWrapperComponent)

    await createFooter()
}

async function replaceOldContent() {
    await Promise.all([
        replaceHeader(),
        replaceMainContent(),
        replaceFooter(),
    ])

}

async function injectLink({ href, media = "all", rel = "stylesheet", type = "text/css", onload = () => { } }) {
    return new Promise((resolve, reject) => {
        const link = document.createElement('link');
        link.href = href;
        link.type = type
        link.rel = rel
        link.media = media
        link.addEventListener('load', async () => { onload(); resolve() });
        link.addEventListener('error', async (e) => { showError(e); resolve() });
        document.head.appendChild(link);
    });
}

async function injectCssFiles() {
    let stylesLinkArray = []
    if (jQuery("link[href='https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Two+Tone|Material+Icons+Round|Material+Icons+Sharp']").length <= 0) {
        stylesLinkArray.push("https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Two+Tone|Material+Icons+Round|Material+Icons+Sharp")
    }
    // stylesLinkArray.push(BPP_STYLE_CSS_FILE_URL)

    await Promise.all(stylesLinkArray.map(href => injectLink({ href })))

}

async function injectJSFiles() {
    // await Promise.all(SCRIPTS_TO_INJECT.map(src => injectScript(src)))
    return true
}

async function commonMainLoad() {

    //Call API and replace the contents on the screen
    await replaceOldContent()

    //After page load scripts
    await afterLoadScriptsBPPNG()

}

async function mainLoad() {

    try {
        //show loading screen if not shown yet
        await ShowSeamlessLoading(true)

        // Before we call the injection scripts()
        await beforeInjectScripts()

        //Inject the required external CSS files
        await injectCssFiles()

        // inject the js files
        await injectJSFiles()

        //Before page load scripts
        await beforeLoadScriptsBPPNG()

        //Call API and replace the contents on the screen
        // await replaceOldContent()

        //After page load scripts
        // await afterLoadScriptsBPPNG()

        // Common function
        await commonMainLoad()

        //stop showing loading screen
        await ShowSeamlessLoading(false)

    } catch (e) {
        console.error(e)
    }

}

window.onload = async function () {
    // Code to execute after the page is fully loaded
    console.log("window onload")
    await mainLoad()
};

document.addEventListener("DOMContentLoaded", async function () { // This event listener will be triggered when the DOM is ready
    // limit the injection to dev and QA environemnt
    console.log("document content loaded")
});

// Define breakpoints for screen sizes
const breakpoints = {
    desktop: 1025,     // Desktop size
    // mobile: 768,   // Tablet size
    // mobile: 480    // Mobile size
};

// Function to determine the current screen size
function getCurrentScreenSize() {
    if (window.innerWidth >= breakpoints.desktop)
        return 'desktop';
    return 'mobile';
}

// Function to handle screen size change
async function onScreenSizeChange() {
    // Add your function call here
    console.log("calling the BPP resize function")
    await commonMainLoad()
}

// Store the last known screen size
let lastScreenSize = getCurrentScreenSize();

// Event listener for resize
window.addEventListener('resize', async () => {
    const newScreenSize = getCurrentScreenSize();
    // Check if the screen size has changed from desktop to tablet or tablet to mobile
    if ((lastScreenSize === 'desktop' && newScreenSize === 'mobile') ||
        (lastScreenSize === 'mobile' && newScreenSize === 'desktop')) {
        onScreenSizeChange()
    }
    // Update the last known screen size
    lastScreenSize = newScreenSize;
});