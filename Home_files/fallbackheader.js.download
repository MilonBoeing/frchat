/////////////////////////////////////////////// Header Tools Ending



const HEADER_COMPONENT_SLOTS = {
    "BgsGlobalHeaderComponent": BgsGlobalHeaderComponent,
}

async function headerComponentSlot(data) {
    const { typeCode } = data
    try {
        if (typeCode && HEADER_COMPONENT_SLOTS[typeCode])
            return await HEADER_COMPONENT_SLOTS[typeCode](data)
    } catch (e) { showError(e) }

}

class BoeingHeaderLogoComponent extends HTMLElement {
    constructor() {
        super()
        this.image_url = ""
        this.redirect_url = ""
        this.image_alt_text = ""
        this.newHeaderText = ""
        this.newHeaderTextRedirect = ""
    }
    static get observedAttributes() { return ["setButtonStatus"]; }
    async BgsGlobalHeaderLogoComponent(headerData) {
        const { siteLogo: { isExternal } } = headerData
        const target = ((isExternal === true || isExternal === "true") ? "_blank" : "")

        return {
            attributes: { class: "header_logo_container" },
            children: [{
                attributes: { class: "header_logo_content" },
                children: [{
                    tagName: 'a',
                    attributes: { class: "header_logo_image", target, href: this.redirect_url },
                    children: [`${ICON_SPRITE.BOEING_LOGO}`]
                },

                this.newHeaderTextRedirect ? {
                    tagName: 'a',
                    attributes: { class: "header_logo_brand_text", href: this.newHeaderTextRedirect, text: this.newHeaderText }
                } : {
                    tagName: 'p',
                    attributes: { class: "header_logo_brand_text", text: this.newHeaderText }
                }]
            }]
        }
    }
    // static get observedAttributes() { return ["setBentoIcon"]; }
    async appendLogoButton(data) {
        $(this).html("")
        const headerLogoObj = await this.BgsGlobalHeaderLogoComponent(data)
        const headerLogoHTML = await createComponent(headerLogoObj)
        $(this).append(headerLogoHTML)
    }
    set setHeaderLogoText(text = this.newHeaderText) {
        $(this).find(".header_logo_brand_text").text(text)
    }
    set setHeaderLogo(data) {
        this.redirect_url = data?.siteLogo?.url || ""
        this.image_url = data?.siteLogo?.socialIcon?.url ? API_DOMAIN_URL + data?.siteLogo?.socialIcon?.url : ""
        this.image_alt_text = data?.siteLogo?.socialIcon?.altText || ""
        this.newHeaderText = data?.udef_txt1 || ""
        this.newHeaderTextRedirect = data?.udef_txt2 || ""
        this.appendLogoButton(data || {})
    }

}
customElements.define("header-logo-element", BoeingHeaderLogoComponent)

function getBgsHeaderToggleComponent() {
    return [
        { tagName: "input", attributes: { type: "checkbox" } },
        {
            tagName: "span",
            attributes: { class: "header_nav_toggle_menu_button" },
            children: [{
                tagName: "i",
                attributes: { class: "material-icons", text: "menu" }
            }],
            eventListeners: {
                click: function () {
                    if (typeof hideIcons === "function") { hideIcons(); }
                    let flag = false;
                    mainIconsAvailability.forEach((item) => {
                        if (item.available && !flag) {
                            flag = true;
                            $(`.${item.key}_icon_list`).show();
                            $(`.${item.slot}`).addClass("active");
                            $(`.${item.key}_back_drop`)?.show();
                        }
                    })
                }
            },
        },
        { tagName: "span", attributes: { class: "header_nav_toggle_close_button" }, children: [{ tagName: "i", attributes: { class: "material-icons", text: "close" } }] },
        {
            attributes: { class: "header_toggle_menu_wrapper" }, children: [
                {
                    attributes: { class: "header_toggle_menu" },
                    children: [
                        {
                            attributes: { class: "header_toggle_menu_content" }, children: [
                                {
                                    attributes: { class: "injected_header_tools menu" }, children: [
                                        window.innerWidth < 1025 ?
                                            {
                                                tagName: "ul", attributes: { class: "injected_header_tool_slots", id: "injected_header_tool_slots" }, children: [
                                                    { tagName: "li", attributes: { class: "home_icon_slot", id: "home_toggle_mobile_slot" }, children: [{ tagName: "header-toggle-mobile-nav" }] },
                                                    { tagName: "li", attributes: { class: "help_icon_slot active", id: "help_icon_slot" }, children: [{ tagName: "header-help-icon" }] },
                                                    { tagName: "li", attributes: { class: "notification_icon_slot", id: "notification_icon_slot" }, children: [{ tagName: "header-bell-icon" }] },
                                                    { tagName: "li", attributes: { class: "bento_icon_slot", id: "bento_icon_slot" }, children: [{ tagName: "header-bento-icon" }] },
                                                    { tagName: "li", attributes: { class: "language_icon_slot", id: "language_icon_slot" }, children: [{ tagName: "header-language-icon" }] },
                                                    { tagName: "li", attributes: { class: "simplified_button_slot", id: "simplified_button_slot" }, children: [{ tagName: "simplified-redirect-button" }] },
                                                    { tagName: "li", attributes: { class: "profile_icon_slot", id: "profile_icon_slot" }, children: [{ tagName: "header-profile-icon" }] },
                                                    { tagName: "li", attributes: { class: "login_icon_slot", id: "login_icon_slot" }, children: [{ tagName: "header-login-icon" }] },
                                                ]
                                            }
                                            : {}

                                    ]
                                }
                            ]
                        },
                        {
                            attributes: { class: "header_toggle_close_wrapper" }, children: [
                                {
                                    tagName: "button", attributes: { class: "header_toggle_menu_close_button" }, children: [{ tagName: "i", attributes: { class: "material-icons", text: "close" } }], eventListeners: {
                                        click: function () { $("label.header_toggle > input").prop('checked', false) }
                                    }
                                }
                            ]
                        },
                    ]
                }
            ]
        }
    ]
}
async function BgsGlobalHeaderComponent(headerData) {
    let isDesktop = window.innerWidth >= 1025;

    const children = [
        { tagName: "label", attributes: { class: "header_toggle" }, children: getBgsHeaderToggleComponent() },
        { tagName: "header-logo-element" },
        { attributes: { id: "header_search_bar_slot", class: "header_search_bar_slot" }, children: [{ tagName: "header-common-search" }] },
        isDesktop ?
            {
                attributes: { class: "injected_header_tools" }, children: [
                    {
                        tagName: "ul", attributes: { class: "injected_header_tool_slots", id: "injected_header_tool_slots" }, children: [
                            { tagName: "li", attributes: { class: "help_icon_slot", id: "help_icon_slot" }, children: [{ tagName: "header-help-icon" }] },
                            { tagName: "li", attributes: { class: "notification_icon_slot", id: "notification_icon_slot" }, children: [{ tagName: "header-bell-icon" }] },
                            { tagName: "li", attributes: { class: "cart_icon_slot", id: "cart_icon_slot" }, children: [{ tagName: "header-cart-icon" }] },
                            { tagName: "li", attributes: { class: "bento_icon_slot", id: "bento_icon_slot" }, children: [{ tagName: "header-bento-icon" }] },
                            { tagName: "li", attributes: { class: "language_icon_slot", id: "language_icon_slot" }, children: [{ tagName: "header-language-icon" }] },
                            { tagName: "li", attributes: { class: "simplified_button_slot", id: "simplified_button_slot" }, children: [{ tagName: "simplified-redirect-button" }] },
                            { tagName: "li", attributes: { class: "profile_icon_slot", id: "profile_icon_slot" }, children: [{ tagName: "header-profile-icon" }] },
                            { tagName: "li", attributes: { class: "login_icon_slot", id: "login_icon_slot" }, children: [{ tagName: "header-login-icon" }] },
                        ]
                    }

                ]
            } :
            {
                attributes: { class: "injected_header_tools" }, children: [
                    {
                        tagName: "ul", attributes: { class: "injected_header_tool_slots", id: "injected_header_tool_slots" }, children: [
                            { tagName: "li", attributes: { class: "cart_icon_slot", id: "cart_icon_slot" }, children: [{ tagName: "header-cart-icon" }] },
                        ]
                    }

                ]
            },
    ]

    return ({
        tagName: "header", attributes: { id: `injected_header_feature`, class: "header" }, children: [{ attributes: { class: "header_main_width_wrapper" }, children: [{ attributes: { class: "header-main" }, children }] }]
    })
}
async function createHeader() {
    try {
        const headerObj = await headerComponentSlot(FALLBACK_DATA[DATA_ENV].HEADER_DATA)

        $(`#${HEADER_SLOTS.getSlot("header").id}`).html("")
        const headerHTML = await createComponent(headerObj)
        $(`#${HEADER_SLOTS.getSlot("header").id}`).append(headerHTML)

        const logoElement = document.querySelector("header-logo-element")
        if (logoElement) logoElement.setHeaderLogo = FALLBACK_DATA[DATA_ENV].HEADER_DATA

        const helpIconElement = document.querySelector("header-help-icon")
        if (helpIconElement) helpIconElement.setHelpIconData = FALLBACK_DATA[DATA_ENV].HEADER_DATA

        const bentoElement = document.querySelector("header-bento-icon")
        if (bentoElement) bentoElement.setBentoIconData = FALLBACK_DATA[DATA_ENV].HEADER_DATA

        const profileElement = document.querySelector("header-profile-icon")
        if (profileElement) profileElement.setProfileData = FALLBACK_DATA[DATA_ENV].HEADER_DATA

    } catch (e) { console.error("something went wrong injecting the header", e) }

}


////// Navigation Scripts

function getNavigationCompleteUrl(url = "") {
    if (url.includes("http")) return url

    const DSI_USER = ((window.bgsExp && window.bgsExp.toLocaleLowerCase() === "distribution") || (window.ref && window.ref.toLocaleLowerCase() === "dsi")) || (window.dsiView && window.dsiView.toLocaleLowerCase() === "dsi")
    const COMMERCIAL_SPARES_USER = ((window.bgsExp && (window.bgsExp.toLocaleLowerCase() === "classiccommercial" || window.bgsExp.toLocaleLowerCase() === "commercial")) || (window.ref && window.ref.toLocaleLowerCase() === "bppng"))

    if (document.cookie.indexOf("commonHdrTgl=true") >= 0 || DSI_USER || COMMERCIAL_SPARES_USER)
        return `${API_DOMAIN_URL}${url}`
    return url
}
function NavLayer2Default(data, menuType) {
    let headingTextElement
    if (data.linkUrl) {
        headingTextElement = { tagName: "a", attributes: { href: getNavigationCompleteUrl(data.linkUrl.url || ""), text: data.name } }
    } else {
        headingTextElement = { tagName: "span", attributes: { text: data.name } }
    }

    let default_list_child;
    if (Array.isArray(data.navListArray)) {
        default_list_child = data.navListArray.map(navitem2 => ({ tagName: "li", attributes: { class: "navigation_menu_L3_list_item" }, children: [{ tagName: "a", attributes: { href: getNavigationCompleteUrl(navitem2?.linkUrl?.url || ""), text: navitem2?.name } }] }))
    } else if (typeof data.navListArray === "object") {
        default_list_child = [{ tagNam: "li", attributes: { class: "navigation_menu_L3_list_item" }, children: [{ tagName: "a", attributes: { href: getNavigationCompleteUrl(data.navListArray?.linkUrl?.url || ""), text: data.navListArray?.name } }] }]
    } else {
        default_list_child = []
    }

    return {
        tagName: "li", attributes: { class: `navigation_menu_L2_list_item ${menuType}` }, children: [
            {
                tagName: "label",
                children: [
                    headingTextElement,
                    { tagName: "input", attributes: { type: "checkbox", name: "navigation_menu_L2_list_item" } },
                    { tagName: 'i', attributes: { class: 'material-icons-outlined add_icon', text: 'add' } },
                    { tagName: 'i', attributes: { class: 'material-icons-outlined remove_icon', text: 'remove' } },
                    { attributes: { class: "navigation_menu_L3_list_wrapper" }, children: [{ tagName: "ul", attributes: { class: "navigation_menu_L3_list" }, children: default_list_child }] }
                ],
                eventListeners: {
                    mousedown: function (e) {
                        const isChecked = $(this).find("input:checkbox").attr("checked")
                        if (isChecked) {
                            $(".navigation_menu_L2_list_item input:checkbox").removeAttr("checked")
                            $(this).find("input:checkbox").attr('checked', 'checked')
                        } else {
                            $(".navigation_menu_L2_list_item input:checkbox").removeAttr("checked")
                        }

                    }
                }
            }
        ]
    }
}
function NavLayer3Products(data) {

    let products_list_l3_child;
    if (Array.isArray(data)) {
        products_list_l3_child = data.map(navitem2 => ({ tagName: 'li', children: [{ tagName: "a", attributes: { href: getNavigationCompleteUrl(navitem2?.linkUrl?.url || ""), text: navitem2?.name } }] }))
    } else if (typeof data === "object") {
        products_list_l3_child = [{ tagName: 'li', children: [{ tagName: "a", attributes: { href: getNavigationCompleteUrl(data?.linkUrl?.url || ""), text: data?.name || "Link 1" } }] }]
    } else {
        products_list_l3_child = []
    }

    return { tagName: "ul", attributes: { class: "products_L3_link_list" }, children: products_list_l3_child }
}

function NavLayer2Product(data, menuType, parent_comp_id, j) {

    let product_list_l2_child;
    if (data.linkUrl) {
        product_list_l2_child = { tagName: "a", attributes: { href: getNavigationCompleteUrl(data.linkUrl.url || ""), text: data.name } }
    } else {
        product_list_l2_child = { tagName: "span", attributes: { text: data.name } }
    }

    let row_class = "one_row"
    if (data && data.navListArray && (Array.isArray(data.navListArray) && data.navListArray.length > 0)) {
        if (data.navListArray.length > 0 && data.navListArray.length <= 12) {
            row_class = "one_row"
        } else if (data.navListArray?.length > 12 && data.navListArray?.length <= 24) {
            row_class = "two_row"
        } else if (data.navListArray?.length > 24 && data.navListArray?.length <= 36) {
            row_class = "three_row"
        } else if (data.navListArray?.length > 36 && data.navListArray?.length <= 48) {
            row_class = "four_row"
        } else if (data.navListArray?.length > 48 && data.navListArray?.length <= 60) {
            row_class = "five_row"
        } else if (data.navListArray?.length > 60 && data.navListArray?.length <= 70) {
            row_class = "six_row"
        }
    } else {
        row_class = "one_row"
    }
    return {
        tagName: "li", attributes: { class: `navigation_menu_L2_list_item ${menuType} ${row_class}` }, eventListeners: {
            mouseenter: async function () {
                $(this).addClass("active")
                if ((Array.isArray(data?.navListArray) && data.navListArray.length > 0) || (typeof data.navListArray === "object" && data.navListArray.name)) {

                    $(this).addClass("expanded")
                    const nav_l3_obj = NavLayer3Products(data.navListArray)
                    const nav_l3_html = await createComponent(nav_l3_obj)
                    $(this).find(".products_L3_link_list_wrapper").html("")
                    $(this).find(".products_L3_link_list_wrapper").append(nav_l3_html)

                    setTimeout(() => {
                        let hgt_child = $(this).find(".products_L3_link_list_wrapper").height() || 0;
                        let hgt_parent = $(`#${parent_comp_id}`).height() || 0;
                        if (hgt_child || hgt_parent) {
                            $(`#${parent_comp_id}`).css("min-height", `${hgt_child > hgt_parent ? hgt_child : hgt_parent}px`);
                            $(`#${parent_comp_id}_${j}`).css("min-height", `${hgt_child > hgt_parent ? hgt_child : hgt_parent}px`);

                            let lastLi = $(this).find(".products_L3_link_list li:last-child");
                            let ul = $(this).find(".products_L3_link_list");
                            if (ul && lastLi) {
                                let wid = Math.trunc((lastLi?.get(0)?.getBoundingClientRect()?.right || 0) - ul.offset().left) + "px";
                                $(`#${parent_comp_id}_${j}`).css("min-width", wid);
                            } else {
                                $(`#${parent_comp_id}_${j}`).css("min-width", "auto");
                            }
                        }
                    }, 0);
                    // const sibling_element = $(this).closest(".navigation_menu_L2_wrapper.PRODUCT").find(".products_L3_link_wrapper")
                    // $(sibling_element).html("")
                    // $(sibling_element).append(nav_l3_html)
                    // $(sibling_element).show()
                }
            },
            mouseleave: async function () {
                $(this).removeClass("active")
                $(this).removeClass("expanded")
                $(`#${parent_comp_id}`).css("min-height", '');
                $(`#${parent_comp_id}_${j}`).css("min-height", '');
                $(`#${parent_comp_id}_${j}`).css("min-width", "auto");
                $(this).find(".products_L3_link_list_wrapper").html("")
                // $(this).closest(".navigation_menu_L2_wrapper.PRODUCT").find(".products_L3_link_wrapper").hide()
            }
        }, children: [product_list_l2_child, { attributes: { class: "products_L3_link_list_wrapper", id: `${parent_comp_id}_${j}` } }]
    }
}
function NavLayer2Marketing(data, menuType) {

    let headingTextElement
    if (data.linkUrl) {
        headingTextElement = { tagName: "a", attributes: { href: getNavigationCompleteUrl(data.linkUrl.url || ""), text: data.name } }
    } else {
        headingTextElement = { tagName: "span", attributes: { text: data.name } }
    }

    let marketing_list_child;
    if (data && data.navListArray && Array.isArray(data.navListArray)) {
        marketing_list_child = data.navListArray.map(navitem2 => ({ tagName: "a", attributes: { href: getNavigationCompleteUrl(navitem2?.linkUrl?.url || ""), text: navitem2?.name } }))
    } else if (typeof data.navListArray === "object") {
        marketing_list_child = [{ tagName: "a", attributes: { href: getNavigationCompleteUrl(data.navListArray?.linkUrl?.url || ""), text: data.navListArray?.name } }]
    } else {
        marketing_list_child = []
    }

    return {
        tagName: "li", attributes: { class: `navigation_menu_L2_list_item ${menuType}` }, children: [
            { tagName: "a", attributes: { class: "marketing_menu_image_link" }, children: [data.spotlight?.image?.url ? { tagName: "img", attributes: { src: API_DOMAIN_URL + data.spotlight.image.url, alt: data.spotlight.image.altText || "" } } : ""] },
            { tagName: "p", attributes: { class: "marketing_menu_link_header" }, children: [headingTextElement] },
            { tagName: "ul", attributes: { class: "marketing_menu_links" }, children: marketing_list_child },
        ]
    }
}

function NavLayer2Component(data, menuType = "DEFAULT", parent_comp_id, j) {
    switch (menuType.toLocaleLowerCase()) {
        case "marketing": return NavLayer2Marketing(data, menuType)
        case "product": return NavLayer2Product(data, menuType, parent_comp_id, j);
        default: return NavLayer2Default(data, menuType)
    }
}

function isLinkItemActive(item) {
    try {
        const { origin, pathname } = window.location
        const currUrl = `${origin}${pathname}`
        let actUrl = item?.linkUrl?.url || '';

        if (!actUrl) return false

        if (actUrl.startsWith("http")) {
            return actUrl.includes(currUrl) || currUrl.includes(actUrl);
        } else {
            return actUrl.includes(pathname) || pathname.includes(actUrl);
        }
    } catch (e) {
        return false
    }
}
function NavLayer1Component(data, l1) {
    let textElement
    if (data.linkUrl) {
        textElement = { tagName: "a", attributes: { href: getNavigationCompleteUrl(data.linkUrl.url || ""), text: data.linkUrl?.linkName || data.name || "", style: data.linkUrl?.styleClasses || "" } }
    } else {
        textElement = { tagName: "span", attributes: { text: data.name || "" } }
    }

    let list_child_1;

    if (data && Array.isArray(data.navListArray)) {
        list_child_1 = data.navListArray.map((navitem2, j) => NavLayer2Component(navitem2, data?.menuType, `l1_${l1}`, j));
    } else if (typeof data.navListArray === "object") {
        list_child_1 = [NavLayer2Component(data.navListArray, data.menuType, `l1_${l1}`, 0)]
    } else {
        list_child_1 = []
    }

    console.log({ data })
    return {
        tagName: "li", attributes: { class: `navigation_menu_L1_item ${data?.menuType} ${isLinkItemActive(data) ? "active" : ""}` }, children: [
            textElement,
            list_child_1.length > 0 ? {
                attributes: { class: `navigation_menu_L2_wrapper ${data?.menuType}`, id: "l1_" + l1 }, children: [
                    { tagName: "ul", attributes: { class: "navigation_menu_L2_list" }, children: list_child_1 },
                ]
            } : ""],
        eventListeners: {
            click: function () {
                if (data.shouldClick) {
                    $(this).toggleClass("active")
                    $(this).find(".navigation_menu_L2_wrapper").toggle();
                }
            },
            mouseenter: function () {
                if (!data.shouldClick) {
                    // $(this).addClass("active")
                    showElement($(this).find(".navigation_menu_L2_wrapper"), "flex");
                }
            },
            mouseleave: function () {
                // $(this).removeClass("active")
                $(".navigation_menu_L2_wrapper").hide();
            },
        }
    }
}

async function navLinkSection(data) {

    let children;
    if (Array.isArray(data?.navListArray)) {
        children = data.navListArray.map((navitem1, i) => NavLayer1Component(navitem1, i))
    } else if (typeof data?.navListArray === "object") {
        children = [NavLayer1Component(data.navListArray, 0)]
    } else {
        children = []
    }

    return {
        attributes: { id: "navigation_menu_wrapper", class: "navigation_menu_wrapper" },
        children: [{ tagName: "ul", attributes: { class: "navigation_menu_L1_wrapper" }, children }]
    }
}
async function navButtonSection(data = []) {

    let btnMap = {
        '': "primary",
        null: "primary",
        PRIMARY: "primary",
        undefined: "primary",
        SECONDARY: "secondary",
    }

    function getButtonComponent(hbtn = {}) {
        return {
            tagName: "a",
            attributes: {
                text: hbtn?.title || '',
                class: "btn-" + btnMap[hbtn?.ctaButtonStyle || ''],
                target: hbtn?.isExternal === 'true' ? "_blank" : '_self',
                href: getNavigationCompleteUrl(hbtn?.url || ""),
            }
        }
    }

    let children = data.map((i) => getButtonComponent(i));
    return {
        attributes: { id: "navigation_menu_wrapper", class: "navigation_menu_wrapper" },
        children: [
            (window.togglebarContent) ? { tagName: "toggle-button-bar", attributes: { class: "toggle_bar_wrapper" } } : "",
            {
                tagName: "ul",
                attributes: { class: "navigation_menu_cta_ul_wrapper" },
                children
            }
        ]
    };
}
async function BgsCategoryNavigationComponent(data) {
    let children = [];
    let headerData = FALLBACK_DATA[DATA_ENV].HEADER_DATA;
    if (headerData?.bgsSubHeaderButtonVisible === "ON") {
        if (headerData?.bgsSubHeaderButton2) {
            children.push(headerData?.bgsSubHeaderButton2);
        };
        if (headerData?.bgsSubHeaderButton) {
            children.push(headerData?.bgsSubHeaderButton);
        }
    }

    if (children.length > 0 || data?.navListArray?.length > 0) {
        return {
            tagName: "nav", attributes: { id: "navigation_desktop_wrapper", class: "navigation_desktop_wrapper" }, children: [
                {
                    attributes: { class: "navigation_desktop_width_wrapper" }, children: [
                        await navLinkSection(data),
                        await navButtonSection(children),
                    ]
                }
            ]
        }
    } else {
        return {};
    }
}


class BoeingDesktopeNavComponent extends HTMLElement {
    constructor() {
        super()
        this.data = false
    }
    static get observedAttributes() { return ["navData"]; }

    async createTopNavDesktop(data) {
        const desktop_nav_obj = await BgsCategoryNavigationComponent(data)
        const desktop_nav_html = await createComponent(desktop_nav_obj)
        $(this).html(desktop_nav_html)
    }

    set navData(data) {
        this.data = data
    }
    set navStatus({ status = "show" }) {
        if (status.toLocaleLowerCase() === "show") {
            this.createTopNavDesktop(this.data)
        } else {
            $(this).html("")
        }
    }

    async attributeChangedCallback(name, oV, nV) {
    }
}
customElements.define("desktop-nav", BoeingDesktopeNavComponent)

class BoeingMobileNavComponent extends HTMLElement {
    constructor() {
        super();
        this.navigationData = {};
        this.stackData = [];
    }
    static get observedAttributes() { return ["navData"]; }

    getNavigationCompleteUrl(url = "") {
        if (url.includes("http")) return url

        const DSI_USER = ((window.bgsExp && window.bgsExp.toLocaleLowerCase() === "distribution") || (window.ref && window.ref.toLocaleLowerCase() === "dsi")) || (window.dsiView && window.dsiView.toLocaleLowerCase() === "dsi")
        const COMMERCIAL_SPARES_USER = ((window.bgsExp && (window.bgsExp.toLocaleLowerCase() === "classiccommercial" || window.bgsExp.toLocaleLowerCase() === "commercial")) || (window.ref && window.ref.toLocaleLowerCase() === "bppng"))

        if (document.cookie.indexOf("commonHdrTgl=true") >= 0 || DSI_USER || COMMERCIAL_SPARES_USER)
            return `${API_DOMAIN_URL}${url}`
        return url
    }
    renderLinkList(self = {}, d = {}) {
        return {
            tagName: 'ul',
            attributes: { class: "nav_list_wrapper" },
            children: (d.navListArray || []).map((linkData) => {
                const { linkUrl, name } = linkData;
                const { external, linkName, url } = (linkUrl || {});
                const target = ((external === true || external === "true") ? "_blank" : "")
                return {
                    tagName: 'li',
                    attributes: { class: "nav-link-list" },
                    children: [
                        url ? {
                            tagName: 'a',
                            attributes: {
                                class: "nav-link-list-anchor",
                                text: linkName || name,
                                href: this.getNavigationCompleteUrl(url),
                                target
                            },
                        } : {
                            tagName: 'button',
                            attributes: {
                                class: "nav-link-list-anchor",
                                text: linkName || name,
                            },
                            eventListeners: {
                                click: function () {
                                    if ((linkData?.navListArray || []).length > 0) {
                                        self.createTopNavMobile(self, linkData || {});
                                    }
                                }
                            }
                        },
                        (linkData?.navListArray || []).length > 0 ?
                            {
                                tagName: "button",
                                attributes: { class: "nav-link-child-arrow" },
                                children: [
                                    { tagName: "span", attributes: { class: "material-icons", text: "keyboard_arrow_right" } }
                                ],
                                eventListeners: {
                                    click: function (event) {
                                        event.preventDefault();
                                        self.createTopNavMobile(self, linkData);
                                    }
                                }
                            }
                            : {}
                    ]
                }
            })
        }
    }

    createFirstStackNav(self = {}, d = {}) {
        if (!d || !(d.navList)) {
            return {};
        } else {
            if (typeof updateIconAvailablity === "function") updateIconAvailablity("nav_icon_list");
        }

        return {
            attributes: { class: 'nav_icon_component' },
            children: [{
                tagName: 'button',
                attributes: { class: 'nav_toggle_button', type: 'button', title: "Home" },
                eventListeners: {
                    click: function () {
                        hideIcons();
                        $(".nav_icon_list").show();
                        $(".home_icon_slot")?.addClass("active");
                    }
                },
                children: [
                    { tagName: "i", attributes: { class: "material-icons header-home-icon", text: "home_outline" } },
                    { tagName: "div", attributes: { class: 'nav_icon_list' }, children: [this.renderLinkList(self, d)] }
                ]
            }]
        };
    }

    createFollowupStackNav(self = {}, d = {}) {
        const { linkUrl, name } = d;
        const { linkName } = (linkUrl || {});
        return {
            attributes: { class: 'nav_stack_component', id: "nav-stack-" + d.uid },
            children: [
                {
                    attributes: { class: "nav_stack_title_component" },
                    children: [
                        {
                            tagName: "button",
                            attributes: { class: "header-back-icon" },
                            children: [{ tagName: "span", attributes: { class: "material-icons", text: "keyboard_arrow_left" } }],
                            eventListeners: {
                                click: function (e) {
                                    //Back
                                    e.preventDefault();
                                    self.removeLastStack(self);
                                }
                            }
                        },
                        { tagName: "div", attributes: { class: "nav-stack-title", text: linkName || name || '' } }
                    ]
                },
                {
                    attributes: { class: "nav_stack_list_component" },
                    children: [
                        { tagName: "div", attributes: { class: 'nav_stack_list' }, children: [this.renderLinkList(self, d)] }
                    ]
                },
            ]
        };
    }

    async createTopNavMobile(self, data) {
        // data.self = this;
        if (!(this.stackData.length)) {
            this.stackData.push(data);
            const mobile_nav_obj = this.createFirstStackNav(self, data);
            const mobile_nav_html = await createComponent(mobile_nav_obj)
            $(this).html(mobile_nav_html);
        } else {
            this.stackData.push(data);
            const mobile_nav_obj = this.createFollowupStackNav(self, data);
            const mobile_nav_html = await createComponent(mobile_nav_obj)
            $(this).append(mobile_nav_html);
        }
    }

    async removeLastStack(self) {
        const lastStack = self.stackData.pop();
        if (lastStack.uid && $('#' + "nav-stack-" + lastStack.uid).length) {
            $('#' + "nav-stack-" + lastStack.uid).remove();
        }
    }

    set navData(data) {
        this.navigationData = data;
        this.createTopNavMobile(this, data)
    }
}
customElements.define("header-toggle-mobile-nav", BoeingMobileNavComponent)


function showElement(SELECTOR, dispalyType = "block") {
    return $(SELECTOR).css("display", dispalyType)
}
async function selectHtmlElement(tagName) {
    let count = 500
    function findAsyncElement(tagName) {
        const element = document.querySelector(tagName)

        if (count > 0) {
            if (element) {
                return element
            } else {
                count--
                delay(500)
                return findAsyncElement(tagName)
            }
        } else {
            Promise.reject("could not find the element")
        }
    }
    return new Promise(function (resolve, reject) {
        resolve(findAsyncElement(tagName))
    });

}

async function createTopNav() {
    try {
        if (ELEMENT_VISIBILITY_STATUS.showNavigation) {

            await $(`#${HEADER_SLOTS.getSlot("navigation").id}`).html("")
            const navElement = await createComponent({ tagName: "desktop-nav" })
            await $(`#${HEADER_SLOTS.getSlot("navigation").id}`).append(navElement)

            const appendedNavElement = await selectHtmlElement("desktop-nav")
            const appendedMobileNavElement = await selectHtmlElement("header-toggle-mobile-nav")

            if (window.innerWidth < 1025) {
                appendedMobileNavElement.navData = FALLBACK_DATA[DATA_ENV].NAVIGATION_MENU_DATA
            } else {
                appendedNavElement.navData = FALLBACK_DATA[DATA_ENV].NAVIGATION_MENU_DATA
            }


        }

    } catch (e) { console.log(e) }
}


//// Navigation scripts ended
//// FOOTER SCRIPTS

const FOOTER_COMPONENT_SLOTS = {
    "BgsFooterComponent": BgsFooterComponent,
    "BgsCommonFooterNavigationComponent": BgsCommonFooterNavigationComponent,
    "BgsSubFooterComponent": BgsSubFooterComponent,
    "BgsFooterLinksComponent": BgsFooterLinksComponent,
    "CMSLinkComponent": CMSLinkComponent,
    "BgsSubFooterSocialIconsComponent": BgsSubFooterSocialIconsComponent
}

async function footerComponentSlot(data) {
    const { typeCode } = data
    try {
        if (typeCode && FOOTER_COMPONENT_SLOTS[typeCode])
            return FOOTER_COMPONENT_SLOTS[typeCode](data)
    } catch (e) {
        console.log(e)
    }

}
async function BgsSubFooterSocialIconsComponent(iconData) {
    const { socialIcon, url, isExternal } = iconData
    const target = ((isExternal === true || isExternal === 'true') ? "_blank" : "");
    const imgAttributes = socialIcon ?
        { alt: socialIcon.altText, src: API_DOMAIN_URL + socialIcon.url } : { alt: '', src: '' };

    function getSocialImages() {
        if (iconData.name.toLocaleLowerCase().includes("facebook")) return ICON_SPRITE.FACEBOOK
        if (iconData.name.toLocaleLowerCase().includes("twitter")) return ICON_SPRITE.TWITTER
        if (iconData.name.toLocaleLowerCase().includes("youtube")) return ICON_SPRITE.YOUTUBE
        if (iconData.name.toLocaleLowerCase().includes("linkedin")) return ICON_SPRITE.LINKEDIN
        return { tagName: 'img', attributes: imgAttributes }

    }

    return {
        tagName: 'li',
        children: [{
            tagName: 'a', attributes: { target, href: url }, children: [
                getSocialImages()
            ]
        }]
    }
}
async function BgsSubFooterLinkComponent(subFooterData) {
    const date = new Date()
    const currentYear = date.getFullYear()
    const copyRightText = `Copyright © ${currentYear || ""} ${subFooterData?.copyRight?.postText || ""}`
    const linkData = { external: true, url: subFooterData?.copyRight?.url || "", linkName: `${copyRightText}` }
    const copyRightChild = await CMSLinkComponent(linkData)
    return [copyRightChild]

}
async function BgsSubFooterSocialLinksComponent(subFooterData) {
    let children = []
    if (subFooterData?.socialIconListArray) {
        const childrenData = subFooterData.socialIconListArray
        children = await Promise.all(childrenData?.map(child => footerComponentSlot(child)))
    }

    return children?.length > 0 ? {
        attributes: { class: "footer-nav-group" }, children: [
            { attributes: { class: "panel-title footer-nav-heading", text: subFooterData?.udef_txt1 || "Follow Boeing" } },
            {
                attributes: { class: "footer-social-icons" },
                children: [{ tagName: 'ul', children }]
            }
        ]
    } : null;
}
async function BgsSubFooterComponent(subFooterData) {
    let children = []
    if (subFooterData.footerListArray) {
        const childrenData = subFooterData.footerListArray
        if (Array.isArray(childrenData)) {
            children = await Promise.all(childrenData?.map(child => footerComponentSlot(child)))
        } else {
            children = await Promise.all([footerComponentSlot(childrenData)])
        }
    };

    return {
        attributes: { class: "sub-footer" }, children: [{
            attributes: { class: "footer-wrapper max-content" }, children: [
                {
                    attributes: { class: "sub-footer-links" }, children: [
                        { tagName: 'ul', children }
                    ]
                },
                {
                    attributes: { class: "sub-footer-links" }, children: [
                        { tagName: 'ul', children: await BgsSubFooterLinkComponent(subFooterData) }
                    ]
                }
            ]
        }]
    }
}


async function CMSLinkComponent(linkData) {
    const { external, linkName, url } = linkData
    const target = ((external === true || external === "true") ? "_blank" : "")
    return { tagName: 'li', children: [{ tagName: 'a', attributes: { text: linkName, href: url, target } }] }
}

function toggleMobileFooterColumn(id) {
    if ($("#ul-" + id).hasClass("hide")) {
        $("#ul-" + id).removeClass("hide");
        $("#dd-" + id).addClass("up");
    } else {
        $("#ul-" + id).addClass("hide");
        $("#dd-" + id).removeClass("up");
    }
}

async function BgsFooterLinksComponent(footerLinkComponentData) {
    let children = []
    let childrenData = false
    if (footerLinkComponentData && footerLinkComponentData?.footerListArray) { childrenData = footerLinkComponentData?.footerListArray }

    if (childrenData) {
        if (typeof childrenData === "object") {
            if (Array.isArray(childrenData)) {
                // filter out null/undefined children before mapping
                const filtered = childrenData.filter(child => child != null)
                children = await Promise.all(filtered.map(child => footerComponentSlot(child)))
            } else {
                if (childrenData != null) {
                    children = await Promise.all([footerComponentSlot(childrenData)])
                }
            }
        }
    }

    // normalize uid: either a non-empty string or undefined (never null)
    const uid = footerLinkComponentData && footerLinkComponentData.uid != null
        ? String(footerLinkComponentData.uid)
        : undefined

    return {
        attributes: { class: "footer-nav-group" }, children: [
            {
                attributes: {
                    class: "panel-title footer-nav-heading",
                    text: footerLinkComponentData?.name || ""
                },
                children: [
                    {
                        tagName: "i",
                        eventListeners: {
                            click: () => toggleMobileFooterColumn(uid ?? "")
                        },
                        attributes: {
                            text: "keyboard_arrow_down",
                            id: uid ? `dd-${uid}` : undefined,
                            class: `material-icons-outlined mobile-arrow`
                        }
                    }
                ]
            },
            {
                tagName: 'ul', children,
                attributes: { class: "mobile hide", id: uid ? `ul-${uid}` : undefined },
            }
        ]
    }
}
