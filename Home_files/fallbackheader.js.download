        ];
        this.supportPortalsUrls = [
            "https://csp.dev1.ebiz.digitalaviationservices.com",
            "https://csp.dev2.ebiz.digitalaviationservices.com",
            "https://csp.dev3.ebiz.digitalaviationservices.com",
