function toggleProfileAccordion(id = '') {
    if ($("#profile_accordion_" + id).hasClass("hide")) {
        $("#profile_accordion_" + id).removeClass("hide");
        $("#profile_tb_up_" + id).removeClass("hide");
        $("#profile_tb_down_" + id).addClass("hide");
    } else {
        $("#profile_accordion_" + id).addClass("hide");
        $("#profile_tb_up_" + id).addClass("hide");
        $("#profile_tb_down_" + id).removeClass("hide");
    }
}

function toggleMyAccountDropdown() {
    if ($(".profile_icon_list").hasClass("hide")) {
        $(".profile_icon_list").show();
        $(".profile_back_drop").show();
        $(".profile_icon_list").removeClass("hide");
    } else {
        $(".profile_icon_list").hide();
        $(".profile_back_drop").hide();
        $(".profile_icon_list").addClass("hide");
    }
}

function toggleLogoutPopup(state = false) {
    if (state) {
        if (!$(".logout_popup_wrapper").hasClass("pp_vissible")) {
            $(".logout_popup_wrapper").addClass("pp_vissible")
        }
    } else {
        $(".logout_popup_wrapper").removeClass("pp_vissible")
    }
}
function logout() {
    let isToggleDefaultON = document.cookie.indexOf("commonHdrTgl=true") >= 0 ? true : false;
    let experience = getCookieValue("bgs_ecomm_exp");
    let new_url = '';

    localStorage.clear();
    sessionStorage.clear();
    document.cookie.split(';').forEach(function (c) {
        document.cookie = c.trim().split('=')[0] + '=;' + 'expires=Thu, 01 Jan 1970 00:00:00 UTC;';
    });

    if (SITE_KEY === "bppnextgen") {
        if (!isToggleDefaultON) {
            new_url = LOGOUT_URL;
        } else {
            new_url = LOGOUT_URL_BPP;
        }
    } else {
        new_url = experience?.toLowerCase?.() === "bppng" ? LOGOUT_URL_BPP : LOGOUT_URL_DSI;
    }

    if (new_url) {
        window.location.href = new_url;
    }
}

function clearCookie(name = '') {
    if (name) {
        document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    }
}

function renderDropdownData(data = [], profileComponentId, account = {}) {
    let mainData = data.find((item) => item.uid === profileComponentId);

    function getSubComponent(item = {}) {
        let sbcUids = item.bgsAccountNavigationLinksCollection || item.cmsLinksList || '';
        let sbcArr = sbcUids.split(' ');
        let sbc = sbcArr.map((item) => data.find((i) => i.uid === item));
        sbc = sbc.filter(i => !!i);
        return sbc;
    }

    function getUrl(linkUrl = '') {
        if (!linkUrl)
            return '';
        return linkUrl?.startsWith("http") ? linkUrl : API_DOMAIN_URL + linkUrl;
    }

    function getUserName() {
        if (account?.userName) {
            return `
                <div class="account_details">
                    <div class="my_account_detail">
                        <p class="header">${account?.userName}</p>
                        <p class="sub_header"></p>
                    </div>
                </div>
            `;
        } else {
            return '';
        }
    }

    function getMyAccountLink() {
        if (ACCOUNT_SSO) {
            return `
                <div class="my_account_link">
                    <a href="${ACCOUNT_SSO}" class="account_link" target="_self">
                        <span>My Account </span>
                    </a>
                </div>
            `;
        } else {
            return '';
        }
    }
    function getAccordions(item = {}) {
        let sbcs = getSubComponent(item) || [];
        let singleLinkWoDropdownAndHeader = sbcs.length === 1 && !(item?.headerText) && item?.udef_bool1 !== 'true';

        return `
            <div class="accordion_item">
                <div class="accordion_header">
                    ${!singleLinkWoDropdownAndHeader ?
                `<p class="profile_list_header_text ${item?.udef_bool1 !== 'true' ? 'open' : ''}">
                            ${item?.media ? `<img src="${getUrl(item?.media?.url || '')}" alt="${item?.media?.code || ''}"/>` : ''}
                            <span>${item?.headerText || ''}</span>
                        </p>` +
                `${item?.udef_bool1 === 'true' ? `
                        <button type="button" class="profile_accordion_toggle" onclick="toggleProfileAccordion('${item?.uid || ''}');">
                            <i class="material-icons-outlined up hide" id="profile_tb_up_${item?.uid || ''}">keyboard_arrow_up</i>
                            <i class="material-icons-outlined down" id="profile_tb_down_${item?.uid || ''}">keyboard_arrow_down</i>
                        </button> ` : ''}` : ''
            }
                    ${singleLinkWoDropdownAndHeader ?
                `<a  class="profile_list_header_text" href="${getUrl(sbcs[0]?.linkUrl)}"
                            target="${sbcs[0]?.isExternal === 'true' ? '_blank' : '_self'}"
                            onclick="toggleMyAccountDropdown()"
                        >
                            ${item?.media ? `<img src="${getUrl(item?.media?.url || '')}" alt="${item?.media?.code || ''}"/>` : ''}
                            <span>${sbcs[0]?.linkText || sbcs[0]?.name || ''}</span>
                        </a>` : ''
            }
                </div>

                ${!singleLinkWoDropdownAndHeader ?
                `<div class="accordion_content ${item?.udef_bool1 === 'true' ? 'hide' : ''}" id="profile_accordion_${item?.uid || ''}">
                    <div class="accordion_body">
                        ${sbcs.map((sbComp, j) => (
                    `<a
                                class="profile_sub_list"
                                href="${getUrl(sbComp.linkUrl)}"
                                onclick="toggleMyAccountDropdown()"
                                target="${sbComp.isExternal === 'true' ? '_blank' : '_self'}"
                            >   ${sbComp.linkText} </a>`
                ))?.join('') || ''
                }
                        </div>
                    </div>
                </div>` : ''}
            `;
    }



    return `
        <div class="profile_dropdown_list">
            ${getUserName()}
            ${getMyAccountLink()}
            ${ELEMENT_VISIBILITY_STATUS?.showTopHatBar?.showShoppingAs ? "<sa-account-selector-dropdowns></sa-account-selector-dropdowns>" : ""}
            ${getSubComponent(mainData).map((item) => getAccordions(item)).join('')}
            ${mainData?.isLogoutButtonEnabled === "true" ?
            `<div class="accordion_item">
                    <div class="accordion_header">
                        <button class="profile_list_header_text" onclick="toggleLogoutPopup(true)">
                            <i class="menu-icon material-icons-outlined">logout</i>
                            <span>${'Log Out'}</span>
                        </button>
                    </div>
                </div>

                <div class="logout_popup_wrapper">
                    <div class=logout_poup>
                        <div class="popup_header_wrapper">
                            <p class="popup_header_text"><i class="error-icon material-icons">error</i> Are you sure you want to log out? </p>
                             <button onclick="toggleLogoutPopup(false)"><i class="close-icon material-icons-outlined">close</i></button>
                        </div>
                        <div class="popup_body_wrapper">
                            <p>Logging out will end your current session and log you out of all related accounts or connected sessions.</p>
                            <p>You will need to sign in again to access those accounts.</p>
                        </div>
                        <div class="popup_footer_wrapper">
                            <button class="btn btn-secondary" onClick="toggleLogoutPopup(false)"><span>${"Cancel"}</span></button>
                            <button class="btn btn-primary" onclick="logout()"><span>${"Log Out"}</span></button>
                        </div>
                    </div>
                </div>
            ` : ''
        }
        </div>
    `
}
class BoeingMyaccountDropdownComponent extends HTMLElement {
    constructor() {
        super()
        this.COMP_ID = false
    }
    static get observedAttributes() { return ["setWrapper"]; }

    async renderDropdown(component, compId) {
        $(this).html(renderDropdownData(component, compId, {}));
    }

    set setWrapper({ status = '', component = [], compId }) {
        if (status == "LOADING") {
            $(this).html(getLoader());
        } else if (status == "SUCCESS") {
            this.renderDropdown(component, compId);
        }
    }
}
customElements.define("myaccount-dropdown", BoeingMyaccountDropdownComponent)


async function BPPCLassicProfileIconComponent() {
    return {
        attributes: { class: 'profile_icon_component' },
        children: [{
            tagName: 'a',
            attributes: { class: 'profile_toggle_button', href: "/partpage/pp/en/USD/my-account/update-profile", title: "Account & Profile" },
            children: [{ tagName: "i", attributes: { class: "material-icons header-profile-icon", text: "account_circle" } }]
        }]
    }
}
async function BGSProfileIconComponent(COMP_UID, iconData) {
    const myaccountData = FALLBACK_DATA[DATA_ENV].PROFILE_ICON_DATA
    console.log("accounts data", myaccountData)
    setTimeout(() => {
        const dropdown = document.querySelector('myaccount-dropdown');
        dropdown.setWrapper = { status: "SUCCESS", component: myaccountData, compId: COMP_UID };
    }, 0);

    if (Array.isArray(myaccountData) && myaccountData.length > 0) {
        updateIconAvailablity("profile_icon_list");
    }

    return myaccountData.length <= 0 ? "" : {
        attributes: { class: 'profile_icon_component' },
        children: [
            {
                attributes: { class: 'profile_toggle_button' },
                tagName: "button",
                children: [
                    {
                        tagName: "i",
                        eventListeners: {
                            click: function () {
                                hideIcons();
                                toggleMyAccountDropdown();
                                $(".profile_icon_slot").addClass("active");
                            }
                        },
                        attributes: { class: "material-icons header-profile-icon", text: "account_circle" }
                    },
                    {
                        attributes: { class: 'profile_icon_list hide' },
                        children: [{
                            attributes: { class: "profile_list_wrapper" },
                            children: [{ tagName: "myaccount-dropdown" }]
                        }]
                    }
                ]
            },
            {
                attributes: { class: "profile_back_drop" },
                eventListeners: { click: function () { toggleMyAccountDropdown(); } },
            }
        ]
    }
}
class BoeingProfileIconComponent extends HTMLElement {
    constructor() {
        super()
        this.url = "/partpage/pp/en/USD/my-account/update-profile"
        this.component_uid = ""
        this.iconData = false
    }
    static get observedAttributes() { return ["setProfileIcon"]; }

    async appendBPPClassicProfileIcon(data) {
        $(this).html("")
        const profileIconObj = await BPPCLassicProfileIconComponent()
        const profileIconHtml = await createComponent(profileIconObj)
        $(this).append(profileIconHtml)
    }

    async appendDSIProfileIcon() {
        $(this).html("")
        const profileIconObj = await BGSProfileIconComponent(this.component_uid, this.iconData)
        const profileIconHtml = await createComponent(profileIconObj)
        $(this).append(profileIconHtml)
    }

    set setProfileIcon({ type = "", component }) {
        $(this).html("")
        if (type.toLocaleLowerCase() === "classic") {
            $(this).append(component)
        } else if (type.toLocaleLowerCase() === "bpp") {
            // this.appendBPPClassicProfileIcon()
            this.appendDSIProfileIcon()
        } else {
            this.appendDSIProfileIcon()
        }
        return true
    }
    set setProfileData(profileData) {
        if (profileData) {
            Object.values(profileData).map(item => {
                if (typeof item === "object" && !Array.isArray(item)) {
                    if (item.typeCode === "BGSLoginOrMyAccountComponent") {
                        this.component_uid = item.uid
                        this.iconData = item
                    }
                }
            })
        }
    }
    async connectedCallback() {


    }
}
customElements.define("header-profile-icon", BoeingProfileIconComponent)






