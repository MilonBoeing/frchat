async function BgsCommonFooterNavigationComponent(subFooterNavigationData) {
    let children = [];
    let TYPES = ["ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX"];
    if (subFooterNavigationData.footerListArray) {
        const childrenData = subFooterNavigationData.footerListArray
        children = await Promise.all(TYPES.map(async (item) => {
            let c = childrenData.filter((d) => d?.columnType === item);
            let d = await Promise.all(c.map(child => footerComponentSlot(child)));
            if (subFooterNavigationData?.columnType === item) {
                d.push(await BgsSubFooterSocialLinksComponent(subFooterNavigationData || {}));
            }
            return { attributes: { class: d.length > 0 ? "footer-column" : '' }, children: d };
        }));
    }
    return ELEMENT_VISIBILITY_STATUS.simplifiedFooter ? {} : {
        attributes: { class: "footer-wrapper max-content" },
        children: [{ attributes: { class: "footer-nav" }, children }]
    };
}
async function BgsFooterComponent(footerData) {
    let children = []
    if (footerData.footerListArray) {
        const childrenData = footerData.footerListArray
        if (Array.isArray(childrenData)) {
            children = await Promise.all(childrenData?.map(child => footerComponentSlot(child)))
        } else {
            children = await Promise.all([footerComponentSlot(childrenData)])
        }
    }

    return ({ tagName: "footer", attributes: { id: `${SITE_KEY}-footer`, class: "footer" }, children })
}


async function createFooter() {
    try {
        const footerObj = await footerComponentSlot(FALLBACK_DATA[DATA_ENV].FOOTER_DATA)
        // const footerHTML = await createComponent(footerObj)
        // $(`#${footerWrapperDIV.id}`).append(footerHTML)

        $(`#${footerWrapperDIV.id}`).html("")
        const footerHTML = await createComponent(footerObj)
        $(`#${footerWrapperDIV.id}`).append(footerHTML)

    } catch (e) { console.log(e, "Something went wrong in injecting the footer") }
}




