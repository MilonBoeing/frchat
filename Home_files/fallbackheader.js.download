        #global_nav_wrapper .header-tools-dropdown {
        top: 38px;
        z-index: 6;
        height: auto;
        max-width: calc(100vw - 20px);
        display: none;
        left: inherit;
        margin-top: 2px;
        margin-left: -12px;
        position: absolute;
        overflow-y: inherit;
        flex-direction: column;
        background-color: #ffffff;
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
        box-shadow: rgba(0, 0, 0, 0.36) 0px 8px 16px 0px;
        --dropdown-pointer-position-left: 24px;
        --dropdown-pointer-position-right: inherit;
        }
        #global_nav_wrapper .header-tools-dropdown:before {
        content: "";
        width: 0;
        height: 0;
        left: var(--dropdown-pointer-position-left);
        bottom: 100%;
        right: var(--dropdown-pointer-position-right);
        position: absolute;
        border-style: solid;
        border-width: 0 8px 8px 8px;
        border-color: #fff transparent !important;
        }
        #global_nav_wrapper .header-tools-dropdown.show {
        display: block;
        }
