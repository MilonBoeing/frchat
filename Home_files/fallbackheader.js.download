        const helpIconObj = await BGSHelpIconComponent(this.component_uid, this.iconData)
        const helpIconHtml = await createComponent(helpIconObj)
        $(this).append(helpIconHtml)


        return true
    }
    set setHelpIconStatus({ type = "" }) {
        $(this).html("")
        if (type.toLocaleLowerCase() === "global") {
            this.appendHelpIcon()
        }
    }
    set setHelpIconData(helpIconData) {
        if (helpIconData) {
            Object.values(helpIconData).map(item => {
                if (typeof item === "object" && !Array.isArray(item)) {
                    if (item.typeCode === "BGSBentoIconsComponent" && ((["support", "help"].some(code => item.image?.code?.toLocaleLowerCase()?.includes(code) || item.name?.toLocaleLowerCase()?.includes(code))))) {
                        this.component_uid = item.uid
                        this.iconData = item
                    }
                }
            })
        }
    }


