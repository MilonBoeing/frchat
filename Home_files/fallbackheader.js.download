            "/my-account/",
            "/price/download_catalog",
            "/procurement",
            "/searchShipTo",
            "/shipTo",
            "/cart/quote",
            "/history/",
        ];
        this.boeingFleetPageUrls = [
            "https://my.dev1.ebiz.digitalaviationservices.com",
            "https://my.dev2.ebiz.digitalaviationservices.com",
            "https://my.dev3.ebiz.digitalaviationservices.com",
            "https://my.dev4.ebiz.digitalaviationservices.com",
            "https://my.dev5.ebiz.digitalaviationservices.com",
            "https://my.dev6.ebiz.digitalaviationservices.com",
            "https://my.dev7.ebiz.digitalaviationservices.com",
            "https://my.dev8.ebiz.digitalaviationservices.com",
            "https://my.dev9.ebiz.digitalaviationservices.com",
