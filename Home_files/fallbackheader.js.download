function updateIconAvailablity(className = '') {
    mainIconsAvailability = mainIconsAvailability.map((item) => {
        if (item.class === className) {
            return { ...item, available: true }
        }
        return item;
    });
}
function hideIcons() {
    $(".help_icon_list").hide();
    $(".help_back_drop").hide();

    $(".bento_icon_list").hide();
    $(".bento_back_drop").hide();

    $(".nav_icon_list").hide();

    hideMyAccountDropdown();

    if (window.innerWidth < 1025) {
        $(".home_icon_slot")?.removeClass("active");
        $(".help_icon_slot")?.removeClass("active");
        $(".notification_icon_slot")?.removeClass("active");
        $(".bento_icon_slot")?.removeClass("active");
        $(".language_icon_slot")?.removeClass("active");
        $(".simplified_button_slot")?.removeClass("active");
    }
}
function hideMyAccountDropdown() {
    $(".profile_icon_list").hide();
    $(".profile_back_drop").hide();
    $(".profile_icon_list").addClass("hide");
    $(".profile_icon_slot")?.removeClass("active");
}

