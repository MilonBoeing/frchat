            "https://staging.support.myboeingfleet.com",
            "https://support.myboeingfleet.com",
            "https://support.boeing.com",
        ];
        this.commonMarketplaceURLs = [
            "shop.boeing.com", // for BDI aviation-supply
            "boeingdistribution.com", // for BDSI prod
            "/partpage", // for BPP all envs
            "bdsi-stg", // for BDSI lower envs

        ]
    }

    static get observedAttributes() {
        return ["setGlobalNav"];
    }

    toggleTopNavDropdown(uid = '') {
        let d = this.globalNavData || {};
        for (let i = 0; i < (d.navListArray || []).length; i++) {
            let uuid = d.navListArray[i].uid || '';
            let btnElem = document.getElementById(uuid);
            let ddElem = document.getElementById("gnav-dd-" + uuid);
            if (ddElem) {
                if (uuid === uid) {
                    let rectClient = btnElem.getBoundingClientRect();

                    if (btnElem.classList.contains("dd-hidden")) {
                        btnElem.classList.remove("dd-hidden");
                        btnElem.classList.add("dd-visible");
                        ddElem.classList.add("show");
                        ddElem.style.top = (rectClient.top + rectClient.height) + "px";

                        let ddRectClient = ddElem.getBoundingClientRect()

                        if ((rectClient.left + ddRectClient.width) > window.innerWidth) {
                            ddElem.style.setProperty("--dropdown-pointer-position-left", `${rectClient.right - (window.innerWidth - (ddRectClient.width)) - (rectClient.width / 2)}px`)
                            ddElem.style.setProperty("--dropdown-pointer-position-right", "inherit")
                            ddElem.style.left = "inherit";
                            ddElem.style.right = "10px";
                        } else {
                            ddElem.style.right = "inherit";
                            ddElem.style.left = (rectClient.left) + "px";
                        }
                    } else if (btnElem.classList.contains("dd-visible")) {
                        btnElem.classList.remove("dd-visible");
                        btnElem.classList.add("dd-hidden");
                        ddElem.classList.remove("show");
                        ddElem.style.right = "inherit";
                        ddElem.style.left = "inherit";
                        ddElem.style.top = "56px";
                    }
                } else {
                    btnElem.classList.remove("dd-visible");
                    btnElem.classList.add("dd-hidden");
                    ddElem.classList.remove("right");
                    ddElem.classList.remove("show");
                    ddElem.style.right = "inherit";
                    ddElem.style.left = "inherit";
                    ddElem.style.top = "56px";
                }
            }
        }
    }


    getCompleteChildrenLinkUrls(item = {}) {
        const urls = [];
        if (item?.linkUrl?.url) urls.push(item?.linkUrl?.url)
        if (Array.isArray(item?.navListArray)) {
            item?.navListArray?.map((childArr) => { if (childArr?.linkUrl?.url) urls.push(childArr?.linkUrl?.url) })
        } else {
            urls.push(item?.navListArray?.linkUrl?.url)
        }
        return urls;
    }
    isPageItemTextPresent(item, text = "") {
        if (!text) return false
        return item?.name?.toLocaleLowerCase().includes(text) || item?.linkUrl?.name?.toLocaleLowerCase().includes(text) || item?.linkUrl?.linkName?.toLocaleLowerCase().includes(text) || false
    }

    getIfL1MenuItemActive(item = {}) {
        const { href, origin, pathname } = window.location;
        const baseUrl = `${origin || ""}${pathname || ""}`

        if (href.includes("partpage") && !this.bppToggleState) {
            if (this.isPageItemTextPresent(item, "shop"))
                return true
            return false
        }

        if ([...this.AccountsPageUrls, ...this.boeingFleetPageUrls, ...this.supportPortalsUrls].some((url) => href?.includes(url))) {
            if (this.AccountsPageUrls.some((url) => href?.includes(url))) {
                if (this.isPageItemTextPresent(item, "account"))
                    return true
                return false
            }
            if (this.boeingFleetPageUrls.some((url) => href?.includes(url))) {
                if (this.isPageItemTextPresent(item, "boeingfleet") || this.isPageItemTextPresent(item, "boeing fleet") || this.isPageItemTextPresent(item, "mbf"))
                    return true
                return false
            }
            if (this.supportPortalsUrls.some((url) => href?.includes(url))) {
                if (this.isPageItemTextPresent(item, "support"))
                    return true
                return false
            }
            return false
        } else {
            if (this.commonMarketplaceURLs.some((url) => href?.includes(url))) {
                if (this.isPageItemTextPresent(item, "shop"))
                    return true
                return false
            }
            if (this.getCompleteChildrenLinkUrls(item).some((url) => url.includes(baseUrl) || baseUrl.includes(url)))
                return true
        }
        return false
    }
    getIfL2MenuItemActive(item = {}) {
        const { origin, pathname } = window.location;
        let currUrl = origin + pathname;
        let actUrl = item?.linkUrl?.url || '';

        if (!actUrl) return false

        if (actUrl.startsWith("http")) {
            return actUrl.includes(currUrl) || currUrl.includes(actUrl);
        } else {
            return actUrl.includes(pathname) || pathname.includes(actUrl);
        }
    }

    getChildNodes(data = {}) {
        return {
            attributes: { class: "nav-item" },
            children: [{
                tagName: "a",
                attributes: {
                    href: data?.linkUrl?.url || "",
                    class: this.getIfL2MenuItemActive(data) ? "pageActive" : '',
                    target: data?.linkUrl?.target == 'true' ? '_blank' : '_self',
                    text: data?.linkUrl?.linkName || ""
                }
            }]
        }
    }
    getParentNodes(item = {}) {
        return {
            tagName: "button",
            attributes: { id: item?.uid, class: `global-nav-item animate dd-hidden ${this.getIfL1MenuItemActive(item) ? "pageActive" : ''}` },
            eventListeners: {
                click: () => this.toggleTopNavDropdown(item?.uid || ''),
            },
            children: [
                (item?.linkUrl) ?
                    {
                        tagName: 'a',
                        attributes: { href: item?.linkUrl?.url || "", class: "global-nav-item-name", target: item?.linkUrl?.target == "true" ? "_blank" : "_self" },
                        children: [{ tagName: "span", attributes: { text: item?.linkUrl?.linkName || "" } }]
                    } : {
                        attributes: { class: "global-nav-item-name" },
                        children: [{ tagName: "span", attributes: { text: item?.name || '' } }]
                    },
                item?.navEntries ? { tagName: 'i', attributes: { class: "material-icons arrow", text: "keyboard_arrow_down" } } : "",
            ]
        }
    }

    renderDropdowns(item = {}) {
        if (item.navEntries) {
            let globalNavL3children = []
            if (Array.isArray(item?.navListArray)) {
                globalNavL3children = item?.navListArray?.map((child) => this.getChildNodes(child))
            } else if (typeof item?.navListArray === "object") {
                globalNavL3children = [this.getChildNodes(item?.navListArray)]
            } else {
                globalNavL3children = []
            }
            return {
                attributes: { class: "header-tools-dropdown", id: `gnav-dd-${item?.uid || ''}` },
                children: [{ attributes: { class: "header-tools-dropdown_wrapper" }, children: globalNavL3children }]
            }
        }
        return ""
    }
    renderDropdownData() {
        if (this.globalNavData?.navEntries) {
            let globalNavL1children = []
            let globalNavL2children = []
            if (Array.isArray(this.globalNavData.navListArray)) {
                globalNavL1children = this.globalNavData.navListArray?.map((child) => this.getParentNodes(child))
                globalNavL2children = this.globalNavData.navListArray?.map((child) => this.renderDropdowns(child))
            } else if (typeof this.globalNavData.navListArray === "object") {
                globalNavL1children = [this.getParentNodes(this.globalNavData.navListArray)]
                globalNavL2children = [this.renderDropdowns(this.globalNavData.navListArray)]
            } else {
                globalNavL1children = []
                globalNavL2children = []
            }
            return {
                tagName: "nav",
                attributes: { class: "header-global-nav", id: this.globalNavData?.uid },
                children: [
                    {
                        attributes: { class: "global-nav-items" },
                        children: globalNavL1children,

                    },
                    ...globalNavL2children,
                ]
            }
        } else {
            return "";
        }
    }

    async getGlobalNavDataFromAPI() {
        this.globalNavData = FALLBACK_DATA[DATA_ENV].GLOBAL_TOP_NAV;
        const globalNavHTML = await createComponent(this.renderDropdownData(FALLBACK_DATA[DATA_ENV].GLOBAL_TOP_NAV))
        $(this).html(globalNavHTML);
    }

    set setGlobalNav(data) {
        $(this).html("")
        this.getGlobalNavDataFromAPI(data)
        return true
    }

    set setGlobalNavigationDefaultState({ status = "hide" }) {
        if (status === "hide") {
            $(".header-tools-dropdown").removeClass("show")
            $(".global-nav-items .global-nav-item").removeClass("dd-visible")
            $(".global-nav-items .global-nav-item").removeClass("dd-hidden")
            $(".global-nav-items .global-nav-item").addClass("dd-hidden")
        }
    }
    async connectedCallback() {
        $(this).html("")
        this.getGlobalNavDataFromAPI()
    }
}
customElements.define("bgs-global-navigation", BoeingGlobalNavigation)

function shoppingAsBarComponentsWrapper() {
    return (ELEMENT_VISIBILITY_STATUS?.showTopHatBar) ? {
        attributes: { id: "shoppping_as_bar_wrapper", class: "shoppping_as_bar_wrapper" },
        children: [
            {
                attributes: { class: "shoppping_as_bar_width_wrapper" }, children: [
                    // (window.togglebarContent && window.showTopHatBar) ? { tagName: "toggle-button-bar", attributes: { class: "toggle_bar_wrapper" } } : "",
                    { attributes: { id: "global_nav_wrapper" }, children: [{ tagName: "bgs-global-navigation" }] },
                ]
            }
        ]
    } : ""
}
async function createShoppingAsBar() {
    $(`#${HEADER_SLOTS.getSlot("tophat").id}`).html("")

    const SHOPPING_AS_BAR_COMPONENTS_WRAPPER_HTML = await createComponent(shoppingAsBarComponentsWrapper())
    $(`#${HEADER_SLOTS.getSlot("tophat").id}`).append(SHOPPING_AS_BAR_COMPONENTS_WRAPPER_HTML)

    document.addEventListener('click', function (e) {

        const dropdwonsToIgnore = $(".header-tools-dropdown.show").find("*").toArray() || [""]
        const globalNavItemsToIgnore = $(".global-nav-items button.global-nav-item").find("*").toArray() || [""]
        if (dropdwonsToIgnore.indexOf(e.target) < 0 && globalNavItemsToIgnore.indexOf(e.target) < 0) {
            const global_navigation_element = document.querySelector("bgs-global-navigation")
            if (global_navigation_element) global_navigation_element.setGlobalNavigationDefaultState = { status: "hide" }
        }
    })
}


