/*********** HTML Injection START ***********/
function createComponent({ attributes = {}, tagName = 'div', children = [], eventListeners = {}, responsiveStyles = {} }) {
    const $element = $('<' + tagName.toLowerCase() + '/>', { ...attributes });

    $.each(eventListeners, function (eventName, handler) {
        $element.on(eventName, handler);
    });

    $.each(children, function (index, child) {
        if (typeof child === 'object') {
            $element.append(createComponent(child));
        } else if (typeof child === 'string') {
            $element.append($(child));
        }
    });

    return $element;
}
const hideElement = (selector) => document.querySelectorAll(selector).forEach((element) => element.style.visibility = "hidden")

function getCookieValue(cookieName) {
    const cookies = document.cookie.split('; ');
    const cookieValues = [];

    cookies.forEach(cookie => {
        const [name, value] = cookie.split('=');
        if (name === cookieName) {
            cookieValues.push(value);
        }
    });

    return cookieValues.length > 0 ? cookieValues[0] : "";
}
function setCookie({ name, value, path = "/", domain, maxAge = "31536000", expires }) {
    const cookieValue = `${name}=${value};${domain ? "domain=" + domain + ";" : ""}path=${path};${expires ? "expires=" + expires : "max-age=" + maxAge};`
    document.cookie = cookieValue;
}




window.currEnv = window.currEnv || "PROD"

let APP_DOMAIN = '';
let B1L_DOMAIN = '';
let LOGOUT_SERVICE_DOMAIN = '';
let ACCOUNT_SSO = "";
let DATA_ENV = "PROD";

switch (currEnv.toUpperCase()) {
    case "DEV":
    case "TST":
    case "TEST": {
        if ((location.href.toLowerCase().indexOf('frz.myboeingfleet.com') >= 0) || (location.href.toLowerCase().indexOf('frz.myboeingfleet.boeing.com') >= 0) || (location.href.toLowerCase().indexOf('onesapecompre.web.boeing.com')) >= 0) {
            APP_DOMAIN = 'pcc5.';
            LOGOUT_SERVICE_DOMAIN = 'frz.';
            DATA_ENV = "PROD"
            ACCOUNT_SSO = "https://uat.accounts.digitalaviationservices.com/?location=Fedp";
        } else {
            APP_DOMAIN = 'qcc5.';
            LOGOUT_SERVICE_DOMAIN = 'frz.';
            DATA_ENV = "QA"
            ACCOUNT_SSO = "https://test.myaccount.digitalaviationservices.com/?location=Fedp";
        }
        break;
    }

    case "VAL":
    case "TEST2":
    case "TST2":
        APP_DOMAIN = 'qcc5.';
        LOGOUT_SERVICE_DOMAIN = 'frz.';
        DATA_ENV = "STAGE"
        ACCOUNT_SSO = "https://test.myaccount.digitalaviationservices.com/?location=Fedp";
        break;

    case "STAGE":
    case "STG":
        APP_DOMAIN = 'scc5.';
        DATA_ENV = "STAGE"
        LOGOUT_SERVICE_DOMAIN = 'frz.';
        ACCOUNT_SSO = "https://uat.accounts.digitalaviationservices.com/?location=Fedp";
        break;

    case "PROD":
        APP_DOMAIN = '';
        DATA_ENV = "PROD"
        LOGOUT_SERVICE_DOMAIN = '';
        ACCOUNT_SSO = "https://accounts.boeing.com/?location=Fedp";
        break;

    default: {
        if ((location.href.toLowerCase().indexOf('https://www.myboeingfleet.com') >= 0) || (location.href.toLowerCase().indexOf('https://myboeingfleet.boeing.com') >= 0)) {
            APP_DOMAIN = '';
            DATA_ENV = "PROD"
            LOGOUT_SERVICE_DOMAIN = '';
            ACCOUNT_SSO = "https://accounts.boeing.com/?location=Fedp";
        } else {
            APP_DOMAIN = 'qcc5.';
            DATA_ENV = "QA"
            LOGOUT_SERVICE_DOMAIN = 'frz.';
            ACCOUNT_SSO = "https://test.myaccount.digitalaviationservices.com/?location=Fedp";
        }
    }
}


