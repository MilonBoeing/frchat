function ShowSeamlessLoading(shouldShow) {
    const loadingElement = document.querySelector("body .seamless_loading")
    const loadingParentElement = document.querySelector('body');
    if (shouldShow) {
        if (!loadingElement) {
            const loading_element = document.createElement('div')
            loading_element.className = 'seamless_loading'
            loading_element.innerHTML = `
                <style>
                    .spinner_div{
                        position: fixed;
                        inset: 0;
                        display: grid;
                        place-items: center;
                        z-index: 999999;
                        background-color: rgba(255, 255, 255);
                    }
                    
                    .spinner_container {
                        width: 66px;
                        height: 66px;
                        border: 8px solid #2299dd;
                        border-radius: 50%;
                        animation: spin 2s linear infinite;
                        position: relative;
                    
                        &:before,
                        &:after{
                            content: "";
                            display: block;
                            width: 25px;
                            height: 25px;
                            border-top: 8px solid #2299dd !important;
                            border-right: 8px solid #2299dd !important;
                            position: absolute;
                            top: -5px;
                            left: -10px;
                            box-shadow: 4px -10px 0 10px #fff;
                        }
                        
                        &:after {
                            top: 33px;
                            left: 33px;
                            border: none !important;
                            border-bottom: 8px solid #2299dd !important;
                            border-left: 8px solid #2299dd !important;
                            box-shadow: -10px 4px 0 4px #fff;
                        }
                    }
  
                    @keyframes spin {
                        0% {
                            transform: rotate(0deg);
                        }
                        100% {
                            transform: rotate(360deg);
                        }
                    }
                </style>
                
            <div class="spinner_div"><div class="spinner_container"><div class="spinner_icon"></div></div></div>`
            if (loadingParentElement) {
                loadingParentElement?.prepend(loading_element)
                const injecteddeplayStyling = document.querySelector("#inject-deplay-styling")
                if (injecteddeplayStyling) {
                    injecteddeplayStyling.innerHTML = ""
                }
            }
        }
    } else {
        if (loadingElement) {
            loadingParentElement?.removeChild(loadingElement);
        }
    }
}
ShowSeamlessLoading(true)
