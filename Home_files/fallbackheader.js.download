        #global_nav_wrapper .global-nav-items {
        display: flex;
        padding: 0px 16px;
        flex-direction: row;
        z-index: 5;
        }
        @media only screen and (max-width: 1024px) {
        #global_nav_wrapper .global-nav-items {
            overflow: auto;
            padding: 0px 16px;
