class BoeingGlobalNavigation extends HTMLElement {
    constructor() {
        super()
        this.globalNavData = {};
        this.hoverActive = null;
        this.pageActive = null;
        this.bppToggleState = document.cookie.indexOf("commonHdrTgl=true") >= 0 ? true : false;
        this.AccountsPageUrls = [
            // Accounts Hub Page
            "myaccount.boeing.com",
